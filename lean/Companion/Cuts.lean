import Companion.Relocation
import Mathlib.SetTheory.Cardinal.NatCard
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Setoid.Basic

/-!
# Cuts

A cut: what a cut of a nested arrangement reads, part by part. Each part yields an object the theorems of the other modules already apply to, and
`Companion.AtCuts` applies them.

- **Level.** An arrangement read as one process is a `Process` (`Arrangement.asProcess`): its members' joint coarse-graining is what it is constituted to make, and its
  kernel, less the diagonal, is the between (`between_eq_asProcess`). At a depth of nesting each arrangement there is taken as one process, and those processes are an
  arrangement whose between is the between at that level (`Nested.between_readLevel`).
- **Scale.** A coarse-graining `c` of the states, and two readings of a process at it, both over the coarse states and both with one constitution, the partition generated by what the process is constituted to make and what `c` identifies. Both make the partition generated by what the process makes and what `c` identifies, so neither gains anything in what it carries, of a quantity of the coarse states (`Process.carries_atScale_iff`, `Process.carries_imageAtScale_iff`). The exact reading gains nothing in following or holding such a quantity either (`Process.follows_atScale_iff`, `Process.holds_atScale_iff`), and the total reading can gain and lose those beyond an exact scale (`total_reading_gains_a_holding`, `total_reading_loses_a_holding`, `total_reading_gains_a_borrowing`). A quantity the scale cannot carry is gone, even at an exact scale (`borrowing_gone_at_exact_scale`, `exact_scale_loses_what_is_carried`).
  The total reading (`Process.imageAtScale`) exists at every scale: its value at a class of what it makes is the set of the process's responses across that class, so nothing is made up (the forward direction of `Process.mem_response_imageAtScale`, and `value_least`) and nothing is left out (`Process.response_mem_imageAtScale`), and a coarser scale makes the value larger (`Process.imageAtScale_mono`, `imageAtScale_grows`).
  The exact reading (`Process.atScale`) keeps the response itself, and it exists exactly where `c` identifies no pair the response separates (`exists_exact_reading_iff`). That is where the total reading's value is one response at every state (`Process.imageAtScale_singleton_iff`), and there the two agree (`Process.response_imageAtScale_eq`). So the demand for the exact response is what excludes a scale (`not_exists_exact_reading`, `Cut.ReadsExactly`), and having a reading is not: `Cut.read` is the total reading wherever an arrangement stands at the level, at any scale, and `Cut.readExactly` the exact one.
- **Span.** Several histories read together are one case of a larger set of states, a state for each history (`Process.overSpan`). An aggregate of the histories is carried by the composite and by no single history (`span_carries_aggregate`), and an aggregate and a history are incomparable (`aggregate_and_history_incomparable`). The process over a span carries each history, so one history out of a span is a coarsening of the joint states (`history_of_span_coarsens`). The order of cuts is over one span by the type of a cut's states.

Residue at a cut is read on pairs of the histories' states before the scale: the pairs the cut's reading, taken as one, identifies. It reads no response, so it asks only that a level stands (`Cut.Stands`), and it is one object under both readings. Counted on the coarse states' own pairs it shrinks as
the scale coarsens (`residue_on_coarse_states_can_shrink`), which is not what Claim 17 (Every level, every join) means. Under a coarser scale at one level it cannot shrink, and under a coarser level it cannot shrink where each arrangement
as a process above is no finer than its members together, every position is an arrangement, and the finer cut's scale identifies only pairs its processes do not tell apart. Each of these conditions has a witness of what fails without it.
-/

namespace Companion

variable {S ι : Type}

/-! ## The level: an arrangement read as one process -/

/-- **A cut, its level.** An arrangement read as one process. It is constituted to make its members' joint coarse-graining; it makes each coarse-graining a member makes, as a
map of that joint value; and its response is its members' responses read together. -/
def Arrangement.asProcess (A : Arrangement S ι) : Process S where
  constitutive := ⟨∀ i, (A.process i).constitutive.Value, fun s i => (A.process i).constitutive s⟩
  Index := Σ i, (A.process i).Index
  Value := fun k => (A.process k.1).Value k.2
  further := fun k v => (A.process k.1).further k.2 (v k.1)
  Action := ∀ i, (A.process i).Action
  rule := fun v i => (A.process i).rule fun k => v ⟨i, k⟩

/-- **Claim 17 (Every level, every join).** An arrangement as one process identifies exactly what every member's constitution identifies. -/
theorem mem_constitution_asProcess (A : Arrangement S ι) (z : Sym2 S) :
    z ∈ A.asProcess.constitution ↔ ∀ i, z ∈ (A.process i).constitution := by
  induction z with
  | _ s t =>
    exact (mem_kernel A.asProcess.constitutive.map s t).trans
      (funext_iff.trans (forall_congr' fun i => (mem_kernel (A.process i).constitutive.map s t).symm))

/-- **Claim 17 (Every level, every join).** An arrangement's response as one process is its members' responses read together, so it separates a pair exactly where one of them does. -/
theorem mem_kernel_response_asProcess (A : Arrangement S ι) (z : Sym2 S) :
    z ∈ kernel A.asProcess.response ↔ ∀ i, z ∈ kernel (A.process i).response := by
  induction z with
  | _ s t =>
    exact (mem_kernel A.asProcess.response s t).trans
      (funext_iff.trans (forall_congr' fun i => (mem_kernel (A.process i).response s t).symm))

/-- **Claim 17 (Every level, every join), the level.** The kernel of an arrangement read as one process, less the diagonal, is its between. -/
theorem between_eq_asProcess (A : Arrangement S ι) : A.between = distinctPairs (kernel A.asProcess.constitutive) := by
  ext z
  exact ⟨fun h => ⟨(mem_constitution_asProcess A z).mpr h.2, h.1⟩, fun h => ⟨h.2, (mem_constitution_asProcess A z).mp h.1⟩⟩

/-- **Claim 17 (Every level, every join), the level.** An arrangement's residue is the residue of its joint coarse-graining. -/
theorem residue_asProcess (A : Arrangement S ι) : residue A.asProcess.constitutive = A.residue :=
  congrArg Set.ncard (between_eq_asProcess A).symm

/-! ## The level: a depth of nesting -/

/-- What indexes the processes at a nested arrangement's own level. -/
def Nested.Positions : Nested S → Type
  | @Nested.mk _ _ ι _ _ => ι

/-- The arrangement at a nested arrangement's own level. -/
def Nested.level : (n : Nested S) → Arrangement S n.Positions
  | .mk _ level _ => level

/-- What each position of a nested arrangement is, if it is an arrangement. -/
def Nested.inner : (n : Nested S) → n.Positions → Option (Nested S)
  | .mk _ _ inner => inner

/-- **A cut, its level.** A nested arrangement taken as one process through its members' joint coarse-graining. `Nested.self` is the process it is at the level above, which the
definition leaves as data; a cut reads this one. -/
def Nested.asProcess (n : Nested S) : Process S :=
  n.level.asProcess

/-- A nested arrangement taken as one process identifies exactly what every process at its own level is constituted to identify. -/
theorem Nested.mem_constitution_asProcess (n : Nested S) (z : Sym2 S) :
    z ∈ n.asProcess.constitution ↔ ∀ p, n.HoldsProcess p → z ∈ p.constitution := by
  cases n with
  | mk self level inner =>
    refine (Companion.mem_constitution_asProcess level z).trans ⟨fun h p hp => ?_, fun h i => h _ ⟨i, rfl⟩⟩
    obtain ⟨i, rfl⟩ := hp
    exact h i

/-- A nested arrangement taken as one process separates by its response exactly what some process at its own level separates by its response. -/
theorem Nested.mem_kernel_response_asProcess (n : Nested S) (z : Sym2 S) :
    z ∈ kernel n.asProcess.response ↔ ∀ p, n.HoldsProcess p → z ∈ kernel p.response := by
  cases n with
  | mk self level inner =>
    refine (Companion.mem_kernel_response_asProcess level z).trans ⟨fun h p hp => ?_, fun h i => h _ ⟨i, rfl⟩⟩
    obtain ⟨i, rfl⟩ := hp
    exact h i

/-- Finitely many arrangements stand at each depth, since each arrangement has finitely many positions. -/
theorem Nested.finite_atDepth (d : ℕ) : ∀ n : Nested S, {m | n.AtDepth d m}.Finite := by
  induction d with
  | zero =>
    intro n
    exact (Set.finite_singleton n).subset fun m hm => Nested.eq_of_atDepth_zero hm
  | succ d ih =>
    intro n
    cases n with
    | mk self level inner =>
      have := level.finite
      have hsub : ∀ i, {x | inner i = some x}.Finite := fun i =>
        Set.Subsingleton.finite fun x hx y hy => Option.some.inj (Eq.trans (Eq.symm hx) hy)
      refine (Set.finite_iUnion fun i => (hsub i).biUnion fun member _ => ih member).subset ?_
      intro m hm
      cases hm with
      | inside hi hm' => exact Set.mem_iUnion.mpr ⟨_, Set.mem_iUnion₂.mpr ⟨_, hi, hm'⟩⟩

/-- Finitely many arrangements stand at each depth, as a type. -/
instance Nested.instFiniteAtDepth (n : Nested S) (d : ℕ) : Finite {m // n.AtDepth d m} :=
  (Nested.finite_atDepth d n).to_subtype

/-- **A cut, its level.** The positions of a reading at a depth: one for each arrangement at that depth. -/
abbrev Nested.LevelPositions (n : Nested S) (d : ℕ) : Type :=
  Fin (Nat.card {m // n.AtDepth d m})

/-- The arrangement at a position of a reading at a depth. -/
noncomputable def Nested.atLevel (n : Nested S) (d : ℕ) (x : n.LevelPositions d) : Nested S :=
  ((Finite.equivFin {m // n.AtDepth d m}).symm x).1

/-- The arrangement at a position of a reading at a depth stands at that depth. -/
theorem Nested.atLevel_atDepth (n : Nested S) (d : ℕ) (x : n.LevelPositions d) : n.AtDepth d (n.atLevel d x) :=
  ((Finite.equivFin {m // n.AtDepth d m}).symm x).2

/-- Every arrangement at a depth stands at some position of the reading at that depth. -/
theorem Nested.exists_atLevel {n m : Nested S} {d : ℕ} (hm : n.AtDepth d m) : ∃ x, n.atLevel d x = m :=
  ⟨Finite.equivFin {m // n.AtDepth d m} ⟨m, hm⟩, by simp [Nested.atLevel]⟩

/-- **A cut, its level.** A nested arrangement read at a depth: an arrangement with a position for each arrangement at that depth, each taken as one process. Its joins are every join
that stands between those processes, a join being a fact of their maps. -/
noncomputable def Nested.readLevel (n : Nested S) (d : ℕ) : Arrangement S (n.LevelPositions d) :=
  ⟨inferInstance, fun x => (n.atLevel d x).asProcess, Set.univ⟩

/-- **Claim 17 (Every level, every join), the level.** The between of a nested arrangement read at a depth is the between at that level. -/
theorem Nested.between_readLevel (n : Nested S) (d : ℕ) : (n.readLevel d).between = n.betweenAt d := by
  ext z
  constructor
  · rintro ⟨hd, hall⟩
    refine ⟨hd, fun m hm p hp => ?_⟩
    obtain ⟨x, rfl⟩ := n.exists_atLevel hm
    exact (Nested.mem_constitution_asProcess _ z).mp (hall x) p hp
  · rintro ⟨hd, hall⟩
    exact ⟨hd, fun x => (Nested.mem_constitution_asProcess _ z).mpr (hall _ (n.atLevel_atDepth d x))⟩

/-! ## The scale -/

/-- **A cut, its scale.** The coarse states of a coarse-graining: the states up to what it identifies. -/
abbrev Coarse {C : Type} (c : S → C) : Type :=
  Quotient (Setoid.ker c)

/-- A state's coarse state. -/
def coarsen {C : Type} (c : S → C) : S → Coarse c :=
  Quotient.mk (Setoid.ker c)

/-- Two states have one coarse state exactly when the coarse-graining identifies them. -/
theorem coarsen_eq_iff {C : Type} (c : S → C) {s t : S} : coarsen c s = coarsen c t ↔ c s = c t :=
  Quotient.eq

/-- **A cut, its scale.** What a process tells apart at a scale: the partition generated by what it identifies and what the scale identifies, the finest of which both are finer. -/
def Process.atScaleSetoid {C : Type} (p : Process S) (c : S → C) : Setoid S :=
  Setoid.ker p.constitutive.map ⊔ Setoid.ker c

/-- A map that identifies what a process identifies, and what a scale identifies, identifies what the process tells apart at that scale. -/
theorem Process.atScaleSetoid_le {C D : Type} (p : Process S) (c : S → C) (d : S → D) (hp : p.constitution ⊆ kernel d) (hc : kernel c ⊆ kernel d) :
    p.atScaleSetoid c ≤ Setoid.ker d := by
  refine sup_le ?_ ?_
  · intro s t hst
    exact (mem_kernel d s t).mp (hp ((mem_kernel p.constitutive.map s t).mpr hst))
  · intro s t hst
    exact (mem_kernel d s t).mp (hc ((mem_kernel c s t).mpr hst))

/-- **A cut, its scale.** What a process makes at a scale: the partition generated by what it makes, its coarse-grainings read together, and what the scale identifies. A process need not make all it is constituted to make, so this can be coarser than `Process.atScaleSetoid`. -/
def Process.makesAtScale {C : Type} (p : Process S) (c : S → C) : Setoid S :=
  Setoid.ker p.jointly ⊔ Setoid.ker c

/-- What a process is constituted to make determines what it makes, so also at a scale. -/
theorem Process.atScaleSetoid_le_makesAtScale {C : Type} (p : Process S) (c : S → C) : p.atScaleSetoid c ≤ p.makesAtScale c :=
  sup_le_sup_right (fun _ _ hst => funext fun k => congrArg (p.further k) hst) _

/-- A map that identifies what a process makes, and what a scale identifies, identifies what the process makes at that scale. -/
theorem Process.makesAtScale_le {C D : Type} (p : Process S) (c : S → C) (d : S → D) (hp : kernel p.jointly ⊆ kernel d) (hc : kernel c ⊆ kernel d) :
    p.makesAtScale c ≤ Setoid.ker d := by
  refine sup_le ?_ ?_
  · intro s t hst
    exact (mem_kernel d s t).mp (hp ((mem_kernel p.jointly s t).mpr hst))
  · intro s t hst
    exact (mem_kernel d s t).mp (hc ((mem_kernel c s t).mpr hst))

/-- By Claim 2 (The condition of response), a response identifies what its coarse-grainings read together identify. -/
theorem kernel_jointly_subset_response (p : Process S) : kernel p.jointly ⊆ kernel p.response :=
  kernel_subset_of_carries (Law.factorization p)

/-- A response identifies what its process makes at a scale, where the scale identifies no pair the response separates. -/
theorem Process.makesAtScale_le_response {C : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) :
    p.makesAtScale c ≤ Setoid.ker p.response :=
  p.makesAtScale_le c p.response (kernel_jointly_subset_response p) h

/-- **A cut, its scale.** What a process is constituted to make at a scale, over the coarse states: the partition generated by what it is constituted to make and what the scale identifies. Both readings at a scale have this constitution, so residue is one object under both. -/
def Process.constitutiveAtScale {C : Type} (p : Process S) (c : S → C) : CoarseGraining (Coarse c) :=
  ⟨Quotient (p.atScaleSetoid c), Quotient.lift (Quotient.mk (p.atScaleSetoid c)) fun _ _ hst =>
    Quotient.sound (s := p.atScaleSetoid c) ((le_sup_right : Setoid.ker c ≤ p.atScaleSetoid c) hst)⟩

/-- **A cut, its scale.** What a process makes at a scale, as a map of what it is constituted to make there: a lift from one quotient to the other, which exists because what a process is constituted to make determines what it makes. -/
def Process.furtherAtScale {C : Type} (p : Process S) (c : S → C) : Quotient (p.atScaleSetoid c) → Quotient (p.makesAtScale c) :=
  Quotient.map' id fun _ _ hst => p.atScaleSetoid_le_makesAtScale c hst

/-- **A cut, its scale, the exact reading.** A process read at a scale, a process over the coarse states, where the scale identifies no pair its response separates. It is constituted to make what its constitution and the scale
generate; it makes what its coarse-grainings and the scale generate, and no more; and its response is the process's own. -/
def Process.atScale {C : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) : Process (Coarse c) where
  constitutive := p.constitutiveAtScale c
  Index := Unit
  Value := fun _ => Quotient (p.makesAtScale c)
  further := fun _ => p.furtherAtScale c
  Action := p.Action
  rule := fun v => Quotient.lift (s := p.makesAtScale c) p.response (fun _ _ hst => p.makesAtScale_le_response c h hst) (v ())

/-- **A cut, its scale, the total reading.** A process read at any scale, a process over the coarse states. It has the exact reading's constitution and makes what the exact reading makes, so residue is one object under both. Its response is a set of the process's responses: its value at a class of what it makes is the set of the process's responses across that class. So it makes nothing up, and the scale is not vacuous: a coarser scale makes the value larger. -/
def Process.imageAtScale {C : Type} (p : Process S) (c : S → C) : Process (Coarse c) where
  constitutive := p.constitutiveAtScale c
  Index := Unit
  Value := fun _ => Quotient (p.makesAtScale c)
  further := fun _ => p.furtherAtScale c
  Action := Set p.Action
  rule := fun v => {a | ∃ s, Quotient.mk (p.makesAtScale c) s = v () ∧ p.response s = a}

/-- **A cut, its scale, the total reading.** The total reading's value at a coarse state, a set of the process's responses. -/
def Process.valueAtScale {C : Type} (p : Process S) (c : S → C) : Coarse c → Set p.Action :=
  (p.imageAtScale c).response

/-- **Claim 17 (Every level, every join), the total reading's value.** Its value at a state's coarse state is the set of the process's responses across the class of that state under what the process makes and the scale identifies. Forward, this is what says nothing is made up: whatever the value holds is the response of the process at some state of that class. That class can reach beyond the coarse state (`value_outside_coarse_state`). -/
theorem Process.mem_response_imageAtScale {C : Type} (p : Process S) (c : S → C) (s : S) (a : p.Action) :
    a ∈ p.valueAtScale c (coarsen c s) ↔ ∃ t, p.makesAtScale c t s ∧ p.response t = a :=
  ⟨fun ⟨t, ht, hr⟩ => ⟨t, Quotient.exact ht, hr⟩, fun ⟨t, ht, hr⟩ => ⟨t, Quotient.sound ht, hr⟩⟩

/-- **Claim 17 (Every level, every join), nothing is left out.** Each state's response lies in the total reading's value there. This is a lower bound, which a value of every action would meet too: what says nothing is made up is `Process.mem_response_imageAtScale`, forward, and `value_least`. -/
theorem Process.response_mem_imageAtScale {C : Type} (p : Process S) (c : S → C) (s : S) : p.response s ∈ p.valueAtScale c (coarsen c s) :=
  (p.mem_response_imageAtScale c s _).mpr ⟨s, (p.makesAtScale c).refl' s, rfl⟩

/-- **Claim 17 (Every level, every join), when the total reading is one response.** The total reading's value is the process's one response at every state exactly when the scale identifies no pair the response separates. So the scale is what makes it more than one. -/
theorem Process.imageAtScale_singleton_iff {C : Type} (p : Process S) (c : S → C) :
    (∀ s, p.valueAtScale c (coarsen c s) = {p.response s}) ↔ kernel c ⊆ kernel p.response := by
  constructor
  · intro h z hz
    induction z with
    | _ s t =>
      have hrel : p.makesAtScale c t s :=
        (le_sup_right : Setoid.ker c ≤ p.makesAtScale c) ((mem_kernel c s t).mp hz).symm
      have hmem : p.response t ∈ p.valueAtScale c (coarsen c s) := (p.mem_response_imageAtScale c s _).mpr ⟨t, hrel, rfl⟩
      rw [h s] at hmem
      exact (mem_kernel _ s t).mpr (Set.mem_singleton_iff.mp hmem).symm
  · intro h s
    ext a
    rw [Set.mem_singleton_iff, p.mem_response_imageAtScale]
    constructor
    · rintro ⟨t, ht, rfl⟩
      exact p.makesAtScale_le_response c h ht
    · rintro rfl
      exact ⟨s, (p.makesAtScale c).refl' s, rfl⟩

/-- **Claim 17 (Every level, every join), where both readings exist, they agree.** At a scale that identifies no pair the response separates, the total reading's value at a coarse state is the one response of the exact reading there. Their constitutions and what they make are one by definition (`Process.constitutiveAtScale`, `Process.furtherAtScale`). -/
theorem Process.response_imageAtScale_eq {C : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (x : Coarse c) :
    p.valueAtScale c x = {(p.atScale c h).response x} := by
  induction x using Quotient.inductionOn with
  | _ s => exact (p.imageAtScale_singleton_iff c).mpr h s

/-- **Claim 17 (Every level, every join), a coarser scale makes the value larger.** The value of the total reading at a state can only grow as the scale coarsens. -/
theorem Process.imageAtScale_mono {C D : Type} (p : Process S) {c : S → C} {d : S → D} (hcd : kernel c ⊆ kernel d) (s : S) :
    p.valueAtScale c (coarsen c s) ⊆ p.valueAtScale d (coarsen d s) := by
  have hle : p.makesAtScale c ≤ p.makesAtScale d := sup_le_sup_left (fun a b hab => (mem_kernel d a b).mp (hcd ((mem_kernel c a b).mpr hab))) _
  intro a ha
  obtain ⟨t, ht, hr⟩ := (p.mem_response_imageAtScale c s a).mp ha
  exact (p.mem_response_imageAtScale d s a).mpr ⟨t, hle ht, hr⟩

/-- A process read at a scale responds at a coarse state as the process does at any state of it. -/
theorem Process.response_atScale {C : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (s : S) :
    (p.atScale c h).response (coarsen c s) = p.response s :=
  rfl

/-- A process read at a scale identifies two coarse states exactly when the partition of what it and the scale identify holds them. -/
theorem Process.mem_constitution_atScale {C : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (s t : S) :
    s(coarsen c s, coarsen c t) ∈ (p.atScale c h).constitution ↔ p.atScaleSetoid c s t :=
  (mem_kernel (p.atScale c h).constitutive.map _ _).trans Quotient.eq

/-- The total reading identifies two coarse states exactly when the partition of what the process's constitution and the scale identify holds them, as the exact reading does. -/
theorem Process.mem_constitution_imageAtScale {C : Type} (p : Process S) (c : S → C) (s t : S) :
    s(coarsen c s, coarsen c t) ∈ (p.imageAtScale c).constitution ↔ p.atScaleSetoid c s t :=
  (mem_kernel (p.imageAtScale c).constitutive.map _ _).trans Quotient.eq

/-- Where the scale identifies only pairs a process's constitution identifies, the process read at that scale tells apart exactly what it does. -/
theorem Process.mem_constitution_atScale_of_subset {C : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (hc : kernel c ⊆ p.constitution) (s t : S) :
    s(coarsen c s, coarsen c t) ∈ (p.atScale c h).constitution ↔ s(s, t) ∈ p.constitution := by
  rw [p.mem_constitution_atScale c h]
  constructor
  · intro hst
    exact (mem_kernel p.constitutive.map s t).mpr (p.atScaleSetoid_le c p.constitutive.map (fun _ hz => hz) hc hst)
  · intro hst
    exact (le_sup_left : Setoid.ker p.constitutive.map ≤ p.atScaleSetoid c) ((mem_kernel p.constitutive.map s t).mp hst)

/-- What the scale cannot carry is gone: a quantity of the states is a quantity of the coarse states read back exactly where the scale identifies no pair it separates. So a reading, whose quantities are of the coarse states, has nothing to say of any other. -/
theorem exists_coarse_quantity_iff {C Q : Type} (c : S → C) (q : S → Q) : (∃ q' : Coarse c → Q, q' ∘ coarsen c = q) ↔ kernel c ⊆ kernel q := by
  constructor
  · rintro ⟨q', rfl⟩ z hz
    induction z with
    | _ s t => exact (mem_kernel _ s t).mpr (congrArg q' ((coarsen_eq_iff c).mpr ((mem_kernel c s t).mp hz)))
  · intro h
    exact ⟨Quotient.lift q fun a b hab => (mem_kernel q a b).mp (h ((mem_kernel c a b).mpr hab)), rfl⟩

/-- **Claim 17 (Every level, every join), the scale.** What a process makes that the scale carries is a map of what it makes at that scale, under the total reading, so the reading keeps every coarse-graining the scale can carry. What the scale cannot carry is gone. -/
theorem Process.exists_map_imageAtScale {C : Type} (p : Process S) (c : S → C) (k : p.Index) (hk : kernel c ⊆ kernel (p.grainings k)) :
    ∃ g : Quotient (p.makesAtScale c) → p.Value k, ∀ s, p.grainings k s = g ((p.imageAtScale c).grainings () (coarsen c s)) := by
  have hle := p.makesAtScale_le c (p.grainings k) (fun z hz => by
    induction z with
    | _ s t => exact (mem_kernel _ s t).mpr (congrFun ((mem_kernel p.jointly s t).mp hz) k)) hk
  exact ⟨Quotient.lift (s := p.makesAtScale c) (p.grainings k) (fun _ _ hst => hle hst), fun _ => rfl⟩

/-- **Claim 17 (Every level, every join), the scale.** The same of the exact reading, which makes what the total reading makes. -/
theorem Process.exists_map_atScale {C : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (k : p.Index) (hk : kernel c ⊆ kernel (p.grainings k)) :
    ∃ g : Quotient (p.makesAtScale c) → p.Value k, ∀ s, p.grainings k s = g ((p.atScale c h).grainings () (coarsen c s)) :=
  p.exists_map_imageAtScale c k hk

/-- A coarse-graining carries what identifies every pair it identifies, there being a state for the values to come from. -/
theorem carries_of_kernel_subset {X C Q : Type} [Nonempty X] {c : X → C} {q : X → Q} (h : kernel c ⊆ kernel q) : Carries c q := by
  obtain ⟨x₀⟩ := ‹Nonempty X›
  have hthrough : Function.FactorsThrough q c := fun s t hst => (mem_kernel q s t).mp (h ((mem_kernel c s t).mpr hst))
  exact ⟨Function.extend c q (fun _ => q x₀), funext fun s => (hthrough.extend_apply _ s).symm⟩

/-- **Claim 17 (Every level, every join), the scale, what a reading carries.** At any scale, the total reading carries a quantity of the coarse states exactly when the process carries that quantity read back on the states, there being a state. So a reading gains nothing in what it carries, of a quantity of the coarse states: at a scale that identifies nothing it carries exactly what the process does, and at a coarser one, what the process carries and the scale can carry. What the process carries that is no quantity of the coarse states is gone, even at a scale that keeps its response (`exact_scale_loses_what_is_carried`). -/
theorem Process.carries_imageAtScale_iff {C Q : Type} [Nonempty S] (p : Process S) (c : S → C) (q' : Coarse c → Q) :
    (p.imageAtScale c).Carries q' ↔ p.Carries (q' ∘ coarsen c) := by
  constructor
  · rintro ⟨g, rfl⟩
    refine carries_of_kernel_subset fun z hz => ?_
    induction z with
    | _ s t =>
      have hst : Quotient.mk (p.makesAtScale c) s = Quotient.mk (p.makesAtScale c) t :=
        Quotient.sound (s := p.makesAtScale c) ((le_sup_left : Setoid.ker p.jointly ≤ p.makesAtScale c) ((mem_kernel p.jointly s t).mp hz))
      exact (mem_kernel _ s t).mpr (congrArg g (funext fun _ => hst))
  · rintro ⟨g, hg⟩
    have hle : p.makesAtScale c ≤ Setoid.ker (q' ∘ coarsen c) := by
      refine sup_le (fun s t hst => ?_) (fun s t hst => ?_)
      · rw [hg]
        exact congrArg g hst
      · exact congrArg q' ((coarsen_eq_iff c).mpr hst)
    refine ⟨fun v => Quotient.lift (s := p.makesAtScale c) (q' ∘ coarsen c) (fun _ _ hst => hle hst) (v ()), funext fun x => ?_⟩
    induction x using Quotient.inductionOn with
    | _ s => rfl

/-- **Claim 17 (Every level, every join), the scale, what a reading carries.** The exact reading makes what the total reading makes, so it carries what that carries. -/
theorem Process.carries_atScale_iff {C Q : Type} [Nonempty S] (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (q' : Coarse c → Q) :
    (p.atScale c h).Carries q' ↔ p.Carries (q' ∘ coarsen c) :=
  p.carries_imageAtScale_iff c q'

/-- **Claim 17 (Every level, every join), the scale, what a reading follows.** At any scale at which a process has its exact reading, its reading follows a quantity across the coarse states of the accessible states exactly when the process follows that quantity read back on the states, across the accessible states. -/
theorem Process.follows_atScale_iff {C Q : Type} (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (X : Accessible S) (q' : Coarse c → Q) :
    Follows (coarsen c '' X) (p.atScale c h).response q' ↔ Follows X p.response (q' ∘ coarsen c) := by
  constructor
  · rintro ⟨hfix, s, ⟨a, ha, rfl⟩, t, ⟨b, hb, rfl⟩, hq, hr⟩
    exact ⟨fun u hu v hv huv => hfix _ ⟨u, hu, rfl⟩ _ ⟨v, hv, rfl⟩ huv, a, ha, b, hb, hq, hr⟩
  · rintro ⟨hfix, a, ha, b, hb, hq, hr⟩
    refine ⟨?_, _, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, hq, hr⟩
    rintro _ ⟨u, hu, rfl⟩ _ ⟨v, hv, rfl⟩ huv
    exact hfix u hu v hv huv

/-- **Claim 17 (Every level, every join), the scale, what a reading holds.** So a reading holds a quantity across the coarse states of the accessible states exactly when the process holds that quantity read back on the states. -/
theorem Process.holds_atScale_iff {C Q : Type} [Nonempty S] (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (X : Accessible S) (q' : Coarse c → Q) :
    (p.atScale c h).Holds (coarsen c '' X) q' ↔ p.Holds X (q' ∘ coarsen c) :=
  and_congr (p.carries_atScale_iff c h q') (p.follows_atScale_iff c h X q')

/-- **Claim 17 (Every level, every join), the scale, what a reading leaves of a borrowing.** Claim 6 (Borrowing)'s premises, following a quantity that is not carried, hold of the exact reading exactly when they hold of the process, of a quantity of the coarse states. So a borrowing of such a quantity does not go away by reading. A borrowing of a quantity the scale cannot carry does (`borrowing_gone_at_exact_scale`). -/
theorem Process.borrowing_atScale_iff {C Q : Type} [Nonempty S] (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (X : Accessible S) (q' : Coarse c → Q) :
    (¬ (p.atScale c h).Carries q' ∧ Follows (coarsen c '' X) (p.atScale c h).response q') ↔ (¬ p.Carries (q' ∘ coarsen c) ∧ Follows X p.response (q' ∘ coarsen c)) :=
  and_congr (not_congr (p.carries_atScale_iff c h q')) (p.follows_atScale_iff c h X q')

/-- **Claim 17 (Every level, every join), the scale, the total reading where it is exact.** At a scale that identifies no pair the response separates, the total reading follows and holds what the exact reading does, its value being that one response. So there it neither gains nor loses a holding, of a quantity of the coarse states. Beyond such a scale it can do either (`total_reading_gains_a_holding`, `total_reading_loses_a_holding`). -/
theorem Process.holds_imageAtScale_iff {C Q : Type} [Nonempty S] (p : Process S) (c : S → C) (h : kernel c ⊆ kernel p.response) (X : Accessible S) (q' : Coarse c → Q) :
    (p.imageAtScale c).Holds (coarsen c '' X) q' ↔ p.Holds X (q' ∘ coarsen c) := by
  have hresponse : p.valueAtScale c = fun x => {(p.atScale c h).response x} := funext (p.response_imageAtScale_eq c h)
  refine and_congr (p.carries_imageAtScale_iff c q') (Iff.trans ?_ (p.follows_atScale_iff c h X q'))
  change Follows (coarsen c '' X) (p.valueAtScale c) q' ↔ _
  rw [hresponse]
  constructor
  · rintro ⟨hfix, s, hs, t, ht, hq, hr⟩
    exact ⟨fun u hu v hv huv => Set.singleton_injective (hfix u hu v hv huv), s, hs, t, ht, hq, fun heq => hr (congrArg (fun a => ({a} : Set p.Action)) heq)⟩
  · rintro ⟨hfix, s, hs, t, ht, hq, hr⟩
    exact ⟨fun u hu v hv huv => congrArg (fun a => ({a} : Set p.Action)) (hfix u hu v hv huv), s, hs, t, ht, hq, fun heq => hr (Set.singleton_injective heq)⟩

/-- **Definition 2 (What a party registers).** A process constituted to tell two bits apart and making only the first: it does not make all it is constituted to make. -/
def tellsBothMakesFirst : Process (Bool × Bool) where
  constitutive := ⟨Bool × Bool, id⟩
  Index := Unit
  Value := fun _ => Bool
  further := fun _ => Prod.fst
  Action := Bool
  rule := fun v => v ()

/-- A scale that identifies nothing identifies only what any map identifies. -/
theorem kernel_id_subset {X C : Type} (d : X → C) : kernel (id : X → X) ⊆ kernel d := by
  intro z hz
  induction z with
  | _ s t =>
    have hst : s = t := (mem_kernel id s t).mp hz
    exact (mem_kernel d s t).mpr (congrArg d hst)

/-- **Claim 17 (Every level, every join), the scale, a borrowing stays.** On two bits, a process constituted to tell both apart and making only the first does not carry the second, and across the states where they agree its response follows it: a case of Claim 6 (Borrowing). Read at the scale that identifies nothing, it still does not carry the second bit and still follows it across those states, so the borrowing is there at the reading. Its reading makes what the process makes, not all it is constituted to. -/
theorem reading_keeps_a_borrowing :
    ¬ tellsBothMakesFirst.Carries (Prod.snd : Bool × Bool → Bool) ∧ Follows {s : Bool × Bool | s.1 = s.2} tellsBothMakesFirst.response (Prod.snd : Bool × Bool → Bool) ∧
      ∀ q' : Coarse (id : Bool × Bool → Bool × Bool) → Bool, (∀ s, q' (coarsen id s) = s.2) →
        ¬ (tellsBothMakesFirst.atScale id (kernel_id_subset _)).Carries q' ∧
          Follows (coarsen id '' {s : Bool × Bool | s.1 = s.2}) (tellsBothMakesFirst.atScale id (kernel_id_subset _)).response q' := by
  have hnot : ¬ tellsBothMakesFirst.Carries (Prod.snd : Bool × Bool → Bool) := by
    rintro ⟨h, hh⟩
    have h0 : (false : Bool) = h (tellsBothMakesFirst.jointly (false, false)) := congrFun hh (false, false)
    have h1 : (true : Bool) = h (tellsBothMakesFirst.jointly (false, true)) := congrFun hh (false, true)
    exact Bool.false_ne_true (h0.trans h1.symm)
  have hfollows : Follows {s : Bool × Bool | s.1 = s.2} tellsBothMakesFirst.response (Prod.snd : Bool × Bool → Bool) := by
    refine ⟨?_, ?_⟩
    · rintro s hs t ht hst
      have hs' : s.1 = s.2 := hs
      have ht' : t.1 = t.2 := ht
      have hst' : s.2 = t.2 := hst
      exact hs'.trans (hst'.trans ht'.symm)
    · exact ⟨(false, false), rfl, (true, true), rfl, Bool.false_ne_true, Bool.false_ne_true⟩
  refine ⟨hnot, hfollows, fun q' hq' => ?_⟩
  have heq : q' ∘ coarsen id = Prod.snd := funext hq'
  refine ⟨fun hc => hnot ?_, (tellsBothMakesFirst.follows_atScale_iff id (kernel_id_subset _) _ q').mpr ?_⟩
  · have hcar := (tellsBothMakesFirst.carries_atScale_iff id (kernel_id_subset _) q').mp hc
    rwa [heq] at hcar
  · rwa [heq]

/-- **Claim 17 (Every level, every join), the exact reading, exactly.** A process yields a process over the coarse states with its exact response exactly when the scale identifies no pair its response separates: the response has to factor through the coarse states. This is about the exact response, not about having a reading, since the total reading exists at every scale. Whether the process is finer than the scale is not the condition: a process may tell apart what the scale identifies, so long as its response does not separate it. -/
theorem exists_exact_reading_iff {C : Type} (p : Process S) (c : S → C) :
    (∃ (q : Process (Coarse c)) (e : q.Action → p.Action), ∀ s, e (q.response (coarsen c s)) = p.response s) ↔ kernel c ⊆ kernel p.response := by
  constructor
  · rintro ⟨q, e, he⟩ z hz
    induction z with
    | _ s t =>
      have hst : coarsen c s = coarsen c t := (coarsen_eq_iff c).mpr ((mem_kernel c s t).mp hz)
      exact (mem_kernel _ s t).mpr ((he s).symm.trans ((congrArg (fun x => e (q.response x)) hst).trans (he t)))
  · exact fun h => ⟨p.atScale c h, id, fun _ => rfl⟩

/-- **Claim 17 (Every level, every join), the exact reading's limit.** No process over the coarse states need have a process's exact response. On two states, a process reads which state obtains and responds with it, and a scale identifies the two: no process over the coarse states has that response. The total reading is there, and its value at the one coarse state holds both responses. -/
theorem not_exists_exact_reading :
    ∃ (S C : Type) (_ : Fintype S) (c : S → C) (p : Process S),
      ¬ ∃ (q : Process (Coarse c)) (e : q.Action → p.Action), ∀ s, e (q.response (coarsen c s)) = p.response s := by
  refine ⟨Bool, Unit, inferInstance, fun _ => (), Process.reading id, fun hex => ?_⟩
  have hsub := (exists_exact_reading_iff _ _).mp hex
  have hin : s(false, true) ∈ kernel (Process.reading id : Process Bool).response := hsub ((mem_kernel _ _ _).mpr rfl)
  exact Bool.false_ne_true ((mem_kernel _ false true).mp hin)

/-- **Claim 17 (Every level, every join), the exact reading.** Being finer than a scale does not stop a process having its exact reading there. On two states, a process tells the states apart and has a constant response, and a scale identifies the two. It tells apart what the scale identifies, and its response survives. -/
theorem exists_exact_reading_of_finer :
    ∃ (S C : Type) (_ : Fintype S) (c : S → C) (p : Process S), kernel c ⊆ kernel p.response ∧ ¬ kernel c ⊆ p.constitution := by
  refine ⟨Bool, Unit, inferInstance, fun _ => (), (Process.reading id).withRule fun _ => (), fun z _ => mem_kernel_const () z, fun hsub => ?_⟩
  have hin : s(false, true) ∈ kernel (id : Bool → Bool) := hsub ((mem_kernel _ _ _).mpr rfl)
  exact Bool.false_ne_true ((mem_kernel id false true).mp hin)

/-- **Claim 17 (Every level, every join), a coarser scale makes the value larger, a witness.** On two states, a process reads which state obtains and responds with it. At the scale that identifies nothing the total reading's value at a state is that state's response alone, and at the scale that identifies the two it holds both responses. So the total reading does not make the scale vacuous. -/
theorem imageAtScale_grows :
    ∃ (S C D : Type) (_ : Fintype S) (p : Process S) (c : S → C) (d : S → D) (s : S),
      kernel c ⊆ kernel d ∧ p.valueAtScale c (coarsen c s) ⊂ p.valueAtScale d (coarsen d s) := by
  let p : Process Bool := Process.reading id
  have hsub : kernel (id : Bool → Bool) ⊆ kernel (fun _ : Bool => ()) := fun z _ => mem_kernel_const () z
  refine ⟨Bool, Bool, Unit, inferInstance, p, id, fun _ => (), false, hsub, p.imageAtScale_mono hsub false, fun hle => ?_⟩
  have hin : p.response true ∈ p.valueAtScale (fun _ : Bool => ()) (coarsen (fun _ : Bool => ()) false) :=
    (p.mem_response_imageAtScale _ false _).mpr ⟨true, (le_sup_right : Setoid.ker (fun _ : Bool => ()) ≤ _) rfl, rfl⟩
  have hsingle := (p.imageAtScale_singleton_iff id).mpr (kernel_id_subset _) false
  have hmem := hle hin
  rw [hsingle] at hmem
  exact Bool.false_ne_true (Set.mem_singleton_iff.mp hmem).symm

/-! ## What the readings keep -/

/-- **Claim 17 (Every level, every join), nothing is made up, as a least value.** The total reading's value is the least that holds each state's response and is carried by what the reading makes: it does both, and any value over the coarse states that does both holds it at each coarse state. -/
theorem value_least {C : Type} (p : Process S) (c : S → C) :
    (∀ s, p.response s ∈ p.valueAtScale c (coarsen c s)) ∧ (p.imageAtScale c).Carries (p.valueAtScale c) ∧
      ∀ V : Coarse c → Set p.Action, (∀ s, p.response s ∈ V (coarsen c s)) → (p.imageAtScale c).Carries V → ∀ x, p.valueAtScale c x ⊆ V x := by
  refine ⟨p.response_mem_imageAtScale c, Law.factorization (p.imageAtScale c), fun V hmem hcar x => ?_⟩
  obtain ⟨g, hg⟩ := hcar
  induction x using Quotient.inductionOn with
  | _ s =>
    intro a ha
    obtain ⟨t, ht, rfl⟩ := (p.mem_response_imageAtScale c s a).mp ha
    have h1 : (p.imageAtScale c).jointly (coarsen c t) = (p.imageAtScale c).jointly (coarsen c s) :=
      funext fun _ => Quotient.sound (s := p.makesAtScale c) ht
    have h2 : V (coarsen c t) = V (coarsen c s) := by
      rw [hg]
      exact congrArg g h1
    have h3 := hmem t
    rw [h2] at h3
    exact h3

/-- What the process of `value_outside_coarse_state` makes: it identifies states 0 and 1. -/
def valueWitnessMake : Fin 3 → Bool :=
  ![false, false, true]

/-- The scale of `value_outside_coarse_state`: it identifies states 1 and 2. -/
def valueWitnessScale : Fin 3 → Bool :=
  ![false, true, true]

/-- **Claim 17 (Every level, every join), the value's class.** A value at a coarse state can hold a response no state of that coarse state gives, from elsewhere in its class. On three states, a process makes what identifies states 0 and 1, and the scale identifies states 1 and 2: state 2's response lies in the value at state 0's coarse state, and neither state 0 nor any state the scale identifies with it responds so. A rule reads what the process makes, so the value is across a class of what it makes and the scale identifies. -/
theorem value_outside_coarse_state :
    (Process.reading valueWitnessMake).response 2 ∈ (Process.reading valueWitnessMake).valueAtScale valueWitnessScale (coarsen valueWitnessScale 0) ∧
      ∀ t, valueWitnessScale t = valueWitnessScale 0 → (Process.reading valueWitnessMake).response t ≠ (Process.reading valueWitnessMake).response 2 := by
  let p : Process (Fin 3) := Process.reading valueWitnessMake
  constructor
  · refine (p.mem_response_imageAtScale valueWitnessScale 0 _).mpr ⟨2, ?_, rfl⟩
    have h1 : p.makesAtScale valueWitnessScale 2 1 :=
      (le_sup_right : Setoid.ker valueWitnessScale ≤ p.makesAtScale valueWitnessScale) (by change valueWitnessScale 2 = valueWitnessScale 1; decide)
    have h2 : p.makesAtScale valueWitnessScale 1 0 := (le_sup_left : Setoid.ker p.jointly ≤ p.makesAtScale valueWitnessScale) (by
      funext _
      change valueWitnessMake 1 = valueWitnessMake 0
      decide)
    exact Setoid.trans' _ h1 h2
  · intro t ht
    have hdec : ∀ t : Fin 3, valueWitnessScale t = valueWitnessScale 0 → valueWitnessMake t ≠ valueWitnessMake 2 := by decide
    exact hdec t ht

/-- The first of two bits, as a quantity of the coarse states of the scale that reads it. -/
def firstBitCoarse : Coarse (Prod.fst : Bool × Bool → Bool) → Bool :=
  Quotient.lift Prod.fst fun _ _ h => h

/-- Where a process on two bits identifies only what the first bit does, what it makes at the scale of the first bit keeps the first bit. -/
theorem fst_eq_of_makesAtScale (p : Process (Bool × Bool)) (hp : kernel p.jointly ⊆ kernel (Prod.fst : Bool × Bool → Bool)) {a b : Bool × Bool}
    (h : p.makesAtScale Prod.fst a b) : a.1 = b.1 :=
  p.makesAtScale_le Prod.fst Prod.fst hp (fun _ hz => hz) h

/-- **Claim 17 (Every level, every join), the total reading can gain a holding.** On two bits, a process reads both and responds with both, and the scale is the first bit. Its total reading holds the first bit, a quantity of the coarse states, since the two sets of responses differ. The process does not hold it, since its response separates what the first bit identifies. The list at the total reading speaks of a set taken as one action, so a difference of sets is a difference of response. -/
theorem total_reading_gains_a_holding :
    ((Process.reading (id : Bool × Bool → Bool × Bool)).imageAtScale Prod.fst).Holds (coarsen Prod.fst '' Set.univ) firstBitCoarse ∧
      ¬ (Process.reading (id : Bool × Bool → Bool × Bool)).Holds Set.univ (firstBitCoarse ∘ coarsen Prod.fst) := by
  let p : Process (Bool × Bool) := Process.reading id
  have hp : kernel p.jointly ⊆ kernel (Prod.fst : Bool × Bool → Bool) := by
    intro z hz
    induction z with
    | _ a b =>
      have : a = b := congrFun ((mem_kernel _ a b).mp hz) ()
      exact (mem_kernel _ a b).mpr (congrArg Prod.fst this)
  have hcoarse : ∀ x y : Coarse (Prod.fst : Bool × Bool → Bool), firstBitCoarse x = firstBitCoarse y → x = y := by
    intro x y
    induction x using Quotient.inductionOn with
    | _ a =>
      induction y using Quotient.inductionOn with
      | _ b =>
        intro h
        exact Quotient.sound (s := Setoid.ker (Prod.fst : Bool × Bool → Bool)) h
  have hcar : (p.imageAtScale Prod.fst).Carries firstBitCoarse :=
    (p.carries_imageAtScale_iff Prod.fst firstBitCoarse).mpr ⟨fun v => (v ()).1, rfl⟩
  refine ⟨⟨hcar, fun x _ y _ h => congrArg _ (hcoarse x y h), ?_⟩, ?_⟩
  · refine ⟨coarsen Prod.fst (false, false), ⟨_, trivial, rfl⟩, coarsen Prod.fst (true, false), ⟨_, trivial, rfl⟩, Bool.false_ne_true, fun heq => ?_⟩
    have hmem : p.response (false, false) ∈ p.valueAtScale Prod.fst (coarsen Prod.fst (false, false)) := p.response_mem_imageAtScale _ _
    have heq' : p.valueAtScale Prod.fst (coarsen Prod.fst (false, false)) = p.valueAtScale Prod.fst (coarsen Prod.fst (true, false)) := heq
    rw [heq'] at hmem
    obtain ⟨t, ht, hr⟩ := (p.mem_response_imageAtScale _ _ _).mp hmem
    have h1 : t.1 = true := fst_eq_of_makesAtScale p hp ht
    have h2 : t = (false, false) := hr
    rw [h2] at h1
    exact absurd h1 (by decide)
  · rintro ⟨-, hfix, -⟩
    have : p.response (false, false) = p.response (false, true) := hfix _ trivial _ trivial rfl
    have h2 : ((false, false) : Bool × Bool) = (false, true) := this
    exact absurd h2 (by decide)

/-- The rule of `total_reading_loses_a_holding`: it joins states 0 and 1. -/
def lossRule : Fin 4 → Fin 3 :=
  ![0, 0, 1, 2]

/-- The scale of `total_reading_loses_a_holding`: it joins states 0 and 3. -/
def lossScale : Fin 4 → Fin 3 :=
  ![0, 1, 2, 0]

/-- What the quantity of `total_reading_loses_a_holding` reads of the scale's values. -/
def lossRead : Fin 3 → Bool :=
  ![false, false, true]

/-- The quantity of `total_reading_loses_a_holding`, over the coarse states. -/
def lossQuantity : Coarse lossScale → Bool :=
  Quotient.lift (fun s => lossRead (lossScale s)) fun _ _ h => congrArg lossRead h

/-- The process of `total_reading_loses_a_holding`: it tells all four states apart, and its rule joins two of them. -/
def lossProcess : Process (Fin 4) :=
  (Process.reading id).withRule fun v => lossRule (v ())

/-- **Claim 17 (Every level, every join), the total reading can lose a holding.** On four states with the last not accessible, a process tells them all apart and its rule joins states 0 and 1, and it holds a quantity of the coarse states. The scale joins states 0 and 3, so the value at state 0's coarse state holds state 3's response as well, and the value at state 1's does not. The quantity gives those two coarse states one value, so the total reading does not hold it. -/
theorem total_reading_loses_a_holding :
    lossProcess.Holds {s | s ≠ 3} (lossQuantity ∘ coarsen lossScale) ∧
      ¬ (lossProcess.imageAtScale lossScale).Holds (coarsen lossScale '' {s | s ≠ 3}) lossQuantity := by
  constructor
  · refine ⟨⟨fun v => lossRead (lossScale (v ())), rfl⟩, ?_, ?_⟩
    · intro s hs t ht h
      have hdec : ∀ s t : Fin 4, s ≠ 3 → t ≠ 3 → lossRead (lossScale s) = lossRead (lossScale t) → lossRule s = lossRule t := by decide
      exact hdec s t hs ht h
    · exact ⟨0, by decide, 2, by decide, (by decide : lossRead (lossScale 0) ≠ lossRead (lossScale 2)), (by decide : lossRule 0 ≠ lossRule 2)⟩
  · rintro ⟨-, hfix, -⟩
    have hsame : lossProcess.valueAtScale lossScale (coarsen lossScale 0) = lossProcess.valueAtScale lossScale (coarsen lossScale 1) :=
      hfix _ ⟨0, by decide, rfl⟩ _ ⟨1, by decide, rfl⟩ (by decide)
    have hmem : lossProcess.response 3 ∈ lossProcess.valueAtScale lossScale (coarsen lossScale 0) :=
      (lossProcess.mem_response_imageAtScale _ _ _).mpr ⟨3, (le_sup_right : Setoid.ker lossScale ≤ lossProcess.makesAtScale lossScale) (by change lossScale 3 = lossScale 0; decide), rfl⟩
    rw [hsame] at hmem
    obtain ⟨t, ht, hr⟩ := (lossProcess.mem_response_imageAtScale _ _ _).mp hmem
    have hclass : lossScale t = lossScale 1 := by
      refine lossProcess.makesAtScale_le lossScale lossScale (fun z hz => ?_) (fun _ hz => hz) ht
      induction z with
      | _ a b =>
        have : a = b := congrFun ((mem_kernel _ a b).mp hz) ()
        exact (mem_kernel _ a b).mpr (congrArg lossScale this)
    have hr' : lossRule t = lossRule 3 := hr
    have hdec : ∀ t : Fin 4, lossScale t = lossScale 1 → lossRule t ≠ lossRule 3 := by decide
    exact hdec t hclass hr'

/-- What the process of `total_reading_gains_a_borrowing` makes, of three bits: the first two. -/
def gainMake : Bool × Bool × Bool → Bool × Bool :=
  fun s => (s.1, s.2.1)

/-- The scale of `total_reading_gains_a_borrowing`, of three bits: the first and the third. -/
def gainScale : Bool × Bool × Bool → Bool × Bool :=
  fun s => (s.1, s.2.2)

/-- The process of `total_reading_gains_a_borrowing`: it makes the first two bits and responds with them. -/
def gainProcess : Process (Bool × Bool × Bool) :=
  Process.reading gainMake

/-- The quantity of `total_reading_gains_a_borrowing`: the third bit, over the coarse states. -/
def gainQuantity : Coarse gainScale → Bool :=
  Quotient.lift (fun s => s.2.2) fun a b h => by
    have h' : gainScale a = gainScale b := h
    exact (congrArg Prod.snd h' : (gainScale a).2 = (gainScale b).2)

/-- What `gainProcess` makes at `gainScale` keeps the first bit. -/
theorem gain_fst_eq {a b : Bool × Bool × Bool} (h : gainProcess.makesAtScale gainScale a b) : a.1 = b.1 := by
  refine gainProcess.makesAtScale_le gainScale Prod.fst (fun z hz => ?_) (fun z hz => ?_) h
  · induction z with
    | _ s t =>
      have this : gainMake s = gainMake t := congrFun ((mem_kernel _ s t).mp hz) ()
      have h' : (gainMake s).1 = (gainMake t).1 := congrArg Prod.fst this
      exact (mem_kernel _ s t).mpr h'
  · induction z with
    | _ s t =>
      have this : gainScale s = gainScale t := (mem_kernel _ s t).mp hz
      have h' : (gainScale s).1 = (gainScale t).1 := congrArg Prod.fst this
      exact (mem_kernel _ s t).mpr h'

/-- States with one first bit have one class of what `gainProcess` makes at `gainScale`. -/
theorem gain_makesAtScale_of_fst_eq {a b : Bool × Bool × Bool} (h : a.1 = b.1) : gainProcess.makesAtScale gainScale a b := by
  obtain ⟨a1, a2, a3⟩ := a
  obtain ⟨b1, b2, b3⟩ := b
  obtain rfl : a1 = b1 := h
  have h1 : gainProcess.makesAtScale gainScale (a1, a2, a3) (a1, a2, b3) :=
    (le_sup_left : Setoid.ker gainProcess.jointly ≤ gainProcess.makesAtScale gainScale) (funext fun _ => rfl)
  have h2 : gainProcess.makesAtScale gainScale (a1, a2, b3) (a1, b2, b3) :=
    (le_sup_right : Setoid.ker gainScale ≤ gainProcess.makesAtScale gainScale) rfl
  exact Setoid.trans' _ h1 h2

/-- States with one first bit have one value under `gainProcess`'s total reading at `gainScale`. -/
theorem gain_value_eq_of_fst_eq {a b : Bool × Bool × Bool} (h : a.1 = b.1) :
    gainProcess.valueAtScale gainScale (coarsen gainScale a) = gainProcess.valueAtScale gainScale (coarsen gainScale b) := by
  ext v
  rw [gainProcess.mem_response_imageAtScale, gainProcess.mem_response_imageAtScale]
  constructor
  · rintro ⟨t, ht, hr⟩
    exact ⟨t, Setoid.trans' _ ht (gain_makesAtScale_of_fst_eq h), hr⟩
  · rintro ⟨t, ht, hr⟩
    exact ⟨t, Setoid.trans' _ ht (gain_makesAtScale_of_fst_eq h.symm), hr⟩

/-- **Claim 17 (Every level, every join), the total reading can gain a borrowing.** On three bits, a process makes the first two and responds with them, and the scale reads the first and third. Across the states where the first and third agree the total reading's value follows the third, which it does not carry: Claim 6 (Borrowing)'s premises. The process does not follow the third there, since its response separates what the third identifies. -/
theorem total_reading_gains_a_borrowing :
    (¬ (gainProcess.imageAtScale gainScale).Carries gainQuantity ∧
        Follows (coarsen gainScale '' {s | s.1 = s.2.2}) (gainProcess.imageAtScale gainScale).response gainQuantity) ∧
      ¬ Follows {s | s.1 = s.2.2} gainProcess.response (gainQuantity ∘ coarsen gainScale) := by
  refine ⟨⟨fun hc => ?_, ?_, ?_⟩, ?_⟩
  · obtain ⟨h, hh⟩ := (gainProcess.carries_imageAtScale_iff gainScale gainQuantity).mp hc
    have h0 : (false : Bool) = h (gainProcess.jointly (false, false, false)) := congrFun hh (false, false, false)
    have h1 : (true : Bool) = h (gainProcess.jointly (false, false, true)) := congrFun hh (false, false, true)
    exact Bool.false_ne_true (h0.trans h1.symm)
  · rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ hq
    have hq' : a.2.2 = b.2.2 := hq
    have ha' : a.1 = a.2.2 := ha
    have hb' : b.1 = b.2.2 := hb
    exact gain_value_eq_of_fst_eq (ha'.trans (hq'.trans hb'.symm))
  · refine ⟨coarsen gainScale (false, false, false), ⟨_, rfl, rfl⟩, coarsen gainScale (true, false, true), ⟨_, rfl, rfl⟩, Bool.false_ne_true, fun heq => ?_⟩
    have heq' : gainProcess.valueAtScale gainScale (coarsen gainScale (false, false, false)) = gainProcess.valueAtScale gainScale (coarsen gainScale (true, false, true)) := heq
    have hmem : gainProcess.response (false, false, false) ∈ gainProcess.valueAtScale gainScale (coarsen gainScale (false, false, false)) := gainProcess.response_mem_imageAtScale _ _
    rw [heq'] at hmem
    obtain ⟨t, ht, hr⟩ := (gainProcess.mem_response_imageAtScale _ _ _).mp hmem
    have h1 : t.1 = true := gain_fst_eq ht
    have h2 : (t.1, t.2.1) = ((false, false) : Bool × Bool) := hr
    have h3 : t.1 = false := congrArg Prod.fst h2
    rw [h1] at h3
    exact absurd h3 (by decide)
  · rintro ⟨hfix, -⟩
    have : gainProcess.response (false, false, false) = gainProcess.response (false, true, false) := hfix _ rfl _ rfl rfl
    have h2 : ((false, false) : Bool × Bool) = (false, true) := this
    exact absurd h2 (by decide)

/-- **Claim 17 (Every level, every join), a borrowing goes at an exact scale, of what the scale cannot carry.** On two bits, a process reads the first and responds with it, and borrows the second across the states where they agree. The scale is the first bit, which keeps the response. No quantity of the coarse states reads the second bit back, and every quantity of the coarse states is carried, so the exact reading has no borrowing of anything. -/
theorem borrowing_gone_at_exact_scale :
    ∃ (p : Process (Bool × Bool)) (c : Bool × Bool → Bool) (h : kernel c ⊆ kernel p.response),
      (¬ p.Carries (Prod.snd : Bool × Bool → Bool) ∧ Follows {s : Bool × Bool | s.1 = s.2} p.response (Prod.snd : Bool × Bool → Bool)) ∧
      (¬ ∃ q' : Coarse c → Bool, q' ∘ coarsen c = Prod.snd) ∧
      ∀ {Q : Type} (q' : Coarse c → Q) (X : Accessible (Coarse c)), ¬ (¬ (p.atScale c h).Carries q' ∧ Follows X (p.atScale c h).response q') := by
  let p : Process (Bool × Bool) := Process.reading Prod.fst
  let c : Bool × Bool → Bool := Prod.fst
  have hk : kernel c ⊆ kernel p.response := fun _ hz => hz
  refine ⟨p, c, hk, ⟨?_, ?_, ?_⟩, ?_, ?_⟩
  · rintro ⟨g, hg⟩
    have h0 : (false : Bool) = g (p.jointly (false, false)) := congrFun hg (false, false)
    have h1 : (true : Bool) = g (p.jointly (false, true)) := congrFun hg (false, true)
    exact Bool.false_ne_true (h0.trans h1.symm)
  · rintro s hs t ht hst
    have hs' : s.1 = s.2 := hs
    have ht' : t.1 = t.2 := ht
    have hst' : s.2 = t.2 := hst
    exact hs'.trans (hst'.trans ht'.symm)
  · exact ⟨(false, false), rfl, (true, true), rfl, Bool.false_ne_true, Bool.false_ne_true⟩
  · intro hex
    have hsub := (exists_coarse_quantity_iff c (Prod.snd : Bool × Bool → Bool)).mp hex
    have hin : s(((false, false) : Bool × Bool), ((false, true) : Bool × Bool)) ∈ kernel (Prod.snd : Bool × Bool → Bool) := hsub ((mem_kernel _ _ _).mpr rfl)
    exact Bool.false_ne_true ((mem_kernel _ _ _).mp hin)
  · rintro Q q' X ⟨hn, -⟩
    refine hn ((p.carries_atScale_iff c hk q').mpr ?_)
    refine carries_of_kernel_subset fun z hz => ?_
    induction z with
    | _ a b =>
      have hab : c a = c b := congrFun ((mem_kernel _ a b).mp hz) ()
      exact (mem_kernel _ a b).mpr (congrArg q' ((coarsen_eq_iff c).mpr hab))

/-- **Claim 17 (Every level, every join), what an exact scale takes away.** On two states, a process tells them apart and has a constant response, and the scale identifies the two. The scale keeps the response, and the process carries the state, and its reading carries nothing that varies: there is one coarse state. -/
theorem exact_scale_loses_what_is_carried :
    ∃ (p : Process Bool) (c : Bool → Unit), kernel c ⊆ kernel p.response ∧ p.Carries (id : Bool → Bool) ∧
      ∀ {Q : Type} (q' : Coarse c → Q), (p.imageAtScale c).Carries q' → ∀ x y, q' x = q' y := by
  let p : Process Bool := (Process.reading id).withRule fun _ => ()
  let c : Bool → Unit := fun _ => ()
  refine ⟨p, c, fun z _ => mem_kernel_const () z, ⟨fun v => v (), rfl⟩, ?_⟩
  intro Q q' _ x y
  have : x = y := by
    induction x using Quotient.inductionOn with
    | _ a =>
      induction y using Quotient.inductionOn with
      | _ b => exact Quotient.sound (s := Setoid.ker c) rfl
  rw [this]

/-! ## The span -/

/-- **A cut, its span.** A process reading several histories together: its states are a state for each history, one case of a larger set of states. It tells apart what it tells apart at
each history, and its response is its responses at each history. -/
def Process.overSpan (τ : Type) (p : Process S) : Process (τ → S) where
  constitutive := ⟨τ → p.constitutive.Value, fun f t => p.constitutive (f t)⟩
  Index := τ × p.Index
  Value := fun k => p.Value k.2
  further := fun k v => p.further k.2 (v k.1)
  Action := τ → p.Action
  rule := fun v t => p.rule fun k => v (t, k)

/-- **Claim 17 (Every level, every join), the span.** A process over a span identifies two joint states exactly when it identifies their states at each history. -/
theorem mem_constitution_overSpan {τ : Type} (p : Process S) (f g : τ → S) :
    s(f, g) ∈ (p.overSpan τ).constitution ↔ ∀ t, s(f t, g t) ∈ p.constitution :=
  (mem_kernel (p.overSpan τ).constitutive.map f g).trans
    (funext_iff.trans (forall_congr' fun t => (mem_kernel p.constitutive.map (f t) (g t)).symm))

/-- A process over a span responds at each history as the process does at that history's state. -/
theorem response_overSpan {τ : Type} (p : Process S) (f : τ → S) (t : τ) : (p.overSpan τ).response f t = p.response (f t) :=
  rfl

/-- **Claim 17 (Every level, every join), the span.** One history read alone is the case itself: over a span of one, a process identifies and responds as it does, carries what it carries, and holds across the accessible states what it holds. -/
theorem overSpan_unit (p : Process S) (s t : S) :
    (s((fun _ => s : Unit → S), (fun _ => t : Unit → S)) ∈ (p.overSpan Unit).constitution ↔ s(s, t) ∈ p.constitution) ∧
      (p.overSpan Unit).response (fun _ => s) () = p.response s ∧
      (∀ {Q : Type} (q : (Unit → S) → Q), (p.overSpan Unit).Carries q ↔ p.Carries fun u => q fun _ => u) ∧
      ∀ {Q : Type} (X : Accessible S) (q : (Unit → S) → Q),
        (p.overSpan Unit).Holds ((fun u _ => u) '' X) q ↔ p.Holds X fun u => q fun _ => u := by
  have hone : ∀ f : Unit → S, (fun _ => f ()) = f := fun f => funext fun _ => rfl
  have hcarries : ∀ {Q : Type} (q : (Unit → S) → Q), (p.overSpan Unit).Carries q ↔ p.Carries fun u => q fun _ => u := by
    intro Q q
    constructor
    · rintro ⟨g, rfl⟩
      exact ⟨fun v => g fun k => v k.2, rfl⟩
    · rintro ⟨g, hg⟩
      refine ⟨fun v => g fun k => v ((), k), funext fun f => ?_⟩
      have hval := congrFun hg (f ())
      change q (fun _ => f ()) = _ at hval
      rw [hone f] at hval
      exact hval
  refine ⟨(mem_constitution_overSpan p _ _).trans ⟨fun h => h (), fun h _ => h⟩, rfl, hcarries, fun X q => ?_⟩
  refine and_congr (hcarries q) ⟨?_, ?_⟩
  · rintro ⟨hfix, _, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, hq, hr⟩
    refine ⟨fun u hu v hv huv => ?_, a, ha, b, hb, hq, fun heq => hr (funext fun _ => heq)⟩
    exact congrFun (hfix _ ⟨u, hu, rfl⟩ _ ⟨v, hv, rfl⟩ huv) ()
  · rintro ⟨hfix, a, ha, b, hb, hq, hr⟩
    refine ⟨?_, _, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, hq, fun heq => hr (congrFun heq ())⟩
    rintro _ ⟨u, hu, rfl⟩ _ ⟨v, hv, rfl⟩ huv
    exact funext fun _ => hfix u hu v hv huv

/-- The aggregate of two histories of one bit: how many of them hold it. -/
def spanTotal (f : Bool → Bool) : ℕ :=
  (f false).toNat + (f true).toNat

/-- **Claim 17 (Every level, every join), the span.** The composite of histories carries what no single history does, as a sequence carries its mean. Over two histories of one bit, the process reading the bit over the span carries
their total, and its reading at either history alone does not. -/
theorem span_carries_aggregate :
    ((Process.reading (id : Bool → Bool)).overSpan Bool).Carries spanTotal ∧ ∀ t : Bool, ¬ Carries (fun f : Bool → Bool => f t) spanTotal := by
  refine ⟨⟨fun v => (v (false, ())).toNat + (v (true, ())).toNat, rfl⟩, ?_⟩
  rintro t ⟨h, hh⟩
  have h0 : spanTotal (fun u => if u = t then false else false) = h false := by
    simpa using congrFun hh (fun u => if u = t then false else false)
  have h1 : spanTotal (fun u => if u = t then false else true) = h false := by
    simpa using congrFun hh (fun u => if u = t then false else true)
  have hne : spanTotal (fun u => if u = t then false else false) ≠ spanTotal (fun u => if u = t then false else true) := by
    cases t <;> decide
  exact hne (h0.trans h1.symm)

/-- **Claim 17 (Every level, every join), the span.** An aggregate of histories and one history are incomparable: over two histories of one bit, neither their total nor the reading of one of them identifies all the other does. This compares two quantities of the joint states, not a process over a span with a history: the process over the span carries both, and one history out of it is a coarsening (`history_of_span_coarsens`). -/
theorem aggregate_and_history_incomparable (t : Bool) :
    ¬ kernel spanTotal ⊆ kernel (fun f : Bool → Bool => f t) ∧ ¬ kernel (fun f : Bool → Bool => f t) ⊆ kernel spanTotal := by
  constructor
  · intro hsub
    have hin := hsub ((mem_kernel spanTotal (fun u => u) (fun u => !u)).mpr (by decide))
    have := (mem_kernel _ _ _).mp hin
    cases t <;> exact absurd this (by decide)
  · intro hsub
    have hin := hsub ((mem_kernel (fun f : Bool → Bool => f t) (fun _ => t) (fun u => if u = t then t else !t)).mpr (by simp))
    have := (mem_kernel _ _ _).mp hin
    cases t <;> exact absurd this (by decide)

/-! ## The cut -/

/-- **A cut.** A cut, over one span of histories `τ`: the level, a depth of nesting, and the scale, a coarse-graining of the states. One history is the span `Unit`, and a span is a finite type with at least one history wherever a theorem uses that. -/
structure Cut (S τ : Type) where
  /-- The depth of nesting it reads at. -/
  level : ℕ
  /-- The values of its coarse-graining. -/
  Scale : Type
  /-- The coarse-graining of the states. -/
  scale : S → Scale

variable {τ : Type}

/-- **A cut.** Over one span, one cut is coarser than another when its level is no deeper and its coarse-graining identifies every pair the other's identifies. -/
def Cut.Coarser (a b : Cut S τ) : Prop :=
  a.level ≤ b.level ∧ kernel b.scale ⊆ kernel a.scale

/-- **A cut.** The states a cut reads: a coarse state for each history. -/
abbrev Cut.States (cut : Cut S τ) : Type :=
  τ → Coarse cut.scale

/-- What a joint state of the histories is at a cut. -/
def Cut.pull (cut : Cut S τ) (f : τ → S) : cut.States :=
  fun t => coarsen cut.scale (f t)

/-- **A cut, The accessible states.** The accessible states at a cut: for each history, the coarse state of an accessible state. -/
def Cut.accessible (cut : Cut S τ) (X : Accessible S) : Accessible cut.States :=
  {f | ∀ t, ∃ s ∈ X, f t = coarsen cut.scale s}

/-- Joint states of accessible states are accessible at a cut. -/
theorem Cut.pull_mem_accessible (cut : Cut S τ) {X : Accessible S} {f : τ → S} (hf : ∀ t, f t ∈ X) : cut.pull f ∈ cut.accessible X :=
  fun t => ⟨f t, hf t, rfl⟩

/-- **A cut, its level.** A cut stands at a nested arrangement when an arrangement stands at its level. Then it has a reading, at any scale and span (`Cut.read`), and residue (`Cut.residue`). -/
def Cut.Stands (cut : Cut S τ) (n : Nested S) : Prop :=
  ∃ m, n.AtDepth cut.level m

/-- **A cut, the exact reading.** A cut has the exact reading of a nested arrangement where an arrangement stands at its level, and its scale identifies no pair the response of an arrangement taken as one process there separates. That is, no response at that level separates a pair the scale identifies (`Cut.readsExactly_iff`). -/
structure Cut.ReadsExactly (cut : Cut S τ) (n : Nested S) : Prop where
  /-- An arrangement stands at its level. -/
  level : cut.Stands n
  /-- Each arrangement at its level, as one process, has its exact reading at the scale. -/
  responses : ∀ m, n.AtDepth cut.level m → kernel cut.scale ⊆ kernel m.asProcess.response

/-- A cut has the exact reading of a nested arrangement just where an arrangement stands at its level and no response at that level separates a pair the scale identifies. -/
theorem Cut.readsExactly_iff (cut : Cut S τ) (n : Nested S) :
    cut.ReadsExactly n ↔ cut.Stands n ∧ ∀ m, n.AtDepth cut.level m → ∀ p, m.HoldsProcess p → kernel cut.scale ⊆ kernel p.response :=
  ⟨fun h => ⟨h.level, fun m hm p hp _ hz => (Nested.mem_kernel_response_asProcess m _).mp (h.responses m hm hz) p hp⟩,
    fun h => ⟨h.1, fun m hm _ hz => (Nested.mem_kernel_response_asProcess m _).mpr fun p hp => h.2 m hm p hp hz⟩⟩

/-- **Claim 17 (Every level, every join), how far the exact reading reaches.** A cut has the exact reading of a nested arrangement just where an arrangement stands at its level and each arrangement there, taken as one process, yields a process over the coarse states with its exact response. -/
theorem Cut.readsExactly_iff_exists_exact_reading (cut : Cut S τ) (n : Nested S) :
    cut.ReadsExactly n ↔ cut.Stands n ∧ ∀ m, n.AtDepth cut.level m →
      ∃ (q : Process (Coarse cut.scale)) (e : q.Action → m.asProcess.Action), ∀ s, e (q.response (coarsen cut.scale s)) = m.asProcess.response s :=
  ⟨fun h => ⟨h.level, fun m hm => (exists_exact_reading_iff _ _).mpr (h.responses m hm)⟩, fun h => ⟨h.1, fun m hm => (exists_exact_reading_iff _ _).mp (h.2 m hm)⟩⟩

/-- **Claim 17 (Every level, every join), the exact reading does not reach every cut.** A cut whose level stands need not read exactly: on two states and one history, a process reads which state obtains and responds with it, and the scale identifies the two. It still has the total reading. -/
theorem exists_cut_not_reads_exactly :
    ∃ (n : Nested Bool) (cut : Cut Bool Unit), cut.Stands n ∧ ¬ cut.ReadsExactly n := by
  let p : Process Bool := Process.reading id
  let n : Nested Bool := .mk p ⟨inferInstance, fun _ : Unit => p, ∅⟩ fun _ => none
  refine ⟨n, ⟨0, Unit, fun _ => ()⟩, ⟨n, .here n⟩, fun h => ?_⟩
  have hin : s(false, true) ∈ kernel n.asProcess.response := h.responses n (.here n) ((mem_kernel _ _ _).mpr rfl)
  have hp := (Nested.mem_kernel_response_asProcess n _).mp hin p ⟨(), rfl⟩
  exact Bool.false_ne_true ((mem_kernel p.response false true).mp hp)

/-- A pair of one state lies in every kernel. -/
theorem mem_kernel_of_isDiag {C : Type} (c : S → C) {z : Sym2 S} (hz : z.IsDiag) : z ∈ kernel c :=
  hz.map

/-- **Claim 17 (Every level, every join), the exact reading.** A cut has the exact reading wherever its scale identifies only pairs in the between at its level. By Claim 9 (The between) no response there separates such a pair. -/
theorem Cut.readsExactly_of_subset_between (cut : Cut S τ) {n : Nested S} (hl : cut.Stands n) (hz : ∀ z ∈ kernel cut.scale, z.IsDiag ∨ z ∈ n.betweenAt cut.level) : cut.ReadsExactly n := by
  refine ⟨hl, fun m hm z hin => (Nested.mem_kernel_response_asProcess m z).mpr fun p hp => ?_⟩
  rcases hz z hin with hd | hb
  · exact mem_kernel_of_isDiag _ hd
  · exact mem_response_of_mem_constitution (hb.2 m hm p hp)

/-- A cut with a scale that identifies nothing has the exact reading wherever an arrangement stands at its level. -/
theorem Cut.readsExactly_of_injective (cut : Cut S τ) {n : Nested S} (hl : cut.Stands n) (hc : Function.Injective cut.scale) : cut.ReadsExactly n := by
  refine cut.readsExactly_of_subset_between hl fun z hz => Or.inl ?_
  induction z with
  | _ s t => exact Sym2.mk_isDiag_iff.mpr (hc ((mem_kernel _ s t).mp hz))

/-- **A cut, the total reading.** One arrangement at a cut's level, as the cut reads it: taken as one process, read at the scale by the total reading, over the span. -/
def Cut.readProcess (cut : Cut S τ) (m : Nested S) : Process cut.States :=
  (m.asProcess.imageAtScale cut.scale).overSpan τ

/-- **A cut, the exact reading.** One arrangement at a cut's level, read at the scale by the exact reading, where the scale identifies no pair its response separates. -/
def Cut.readProcessExactly (cut : Cut S τ) (m : Nested S) (h : kernel cut.scale ⊆ kernel m.asProcess.response) : Process cut.States :=
  (m.asProcess.atScale cut.scale h).overSpan τ

/-- **A cut, the total reading.** What a cut reads of a nested arrangement where an arrangement stands at its level, at any scale: an arrangement over the cut's states with a position for each arrangement at its level, each read by `Cut.readProcess`. Its joins are every join that stands between those processes, a join being a fact of their maps. The hypothesis is a guard, and the definition does not use it: at a level that does not stand the same reading has no positions. -/
noncomputable def Cut.read (cut : Cut S τ) {n : Nested S} (_h : cut.Stands n) : Arrangement cut.States (n.LevelPositions cut.level) :=
  ⟨inferInstance, fun x => cut.readProcess (n.atLevel cut.level x), Set.univ⟩

/-- **A cut, the exact reading.** What a cut reads of a nested arrangement where its scale identifies no pair a response at its level separates: the same positions, each read by `Cut.readProcessExactly`, and every join that stands. -/
noncomputable def Cut.readExactly (cut : Cut S τ) {n : Nested S} (h : cut.ReadsExactly n) : Arrangement cut.States (n.LevelPositions cut.level) :=
  ⟨inferInstance, fun x => cut.readProcessExactly (n.atLevel cut.level x) (h.responses _ (n.atLevel_atDepth _ x)), Set.univ⟩

/-- **Claim 17 (Every level, every join).** The processes a cut reads exactly respond as the processes at its level do: at each history, each member's response at that history's state. -/
theorem Cut.response_readExactly (cut : Cut S τ) {n : Nested S} (h : cut.ReadsExactly n) (x : n.LevelPositions cut.level) (f : τ → S) (t : τ) (i : (n.atLevel cut.level x).Positions) :
    ((cut.readExactly h).process x).response (cut.pull f) t i = ((n.atLevel cut.level x).level.process i).response (f t) :=
  rfl

/-- **Claim 17 (Every level, every join), the two readings have one constitution.** At a cut that reads exactly, each process has one constitution under both readings, so residue is one object under both. -/
theorem Cut.constitution_read_eq_readExactly (cut : Cut S τ) {n : Nested S} (h : cut.ReadsExactly n) (x : n.LevelPositions cut.level) :
    ((cut.read h.level).process x).constitution = ((cut.readExactly h).process x).constitution :=
  rfl

/-- **Claim 17 (Every level, every join), nothing is left out at a cut.** The value a cut reads at a history holds the response of the arrangement at its level, at that history's state. -/
theorem Cut.response_mem_read (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) (x : n.LevelPositions cut.level) (f : τ → S) (t : τ) :
    (n.atLevel cut.level x).asProcess.response (f t) ∈ (n.atLevel cut.level x).asProcess.valueAtScale cut.scale (cut.pull f t) ∧
      ((cut.read h).process x).response (cut.pull f) t = (n.atLevel cut.level x).asProcess.valueAtScale cut.scale (cut.pull f t) :=
  ⟨Process.response_mem_imageAtScale _ _ _, rfl⟩

/-- **Claim 17 (Every level, every join), the two readings agree where both exist.** At a cut that reads exactly, the value of the total reading at a history is the one response of the exact reading there. -/
theorem Cut.response_read_eq (cut : Cut S τ) {n : Nested S} (h : cut.ReadsExactly n) (x : n.LevelPositions cut.level) (f : τ → S) (t : τ) :
    (n.atLevel cut.level x).asProcess.valueAtScale cut.scale (cut.pull f t) = {((cut.readExactly h).process x).response (cut.pull f) t} :=
  Process.response_imageAtScale_eq _ _ (h.responses _ (n.atLevel_atDepth _ x)) _

/-- **Claim 17 (Every level, every join), the total reading is one response just where the exact reading is.** Where an arrangement stands at a cut's level, the value of every process it reads is one response at every state exactly when no response at the level separates a pair the scale identifies. -/
theorem Cut.value_singleton_iff (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) :
    (∀ x s, (n.atLevel cut.level x).asProcess.valueAtScale cut.scale (coarsen cut.scale s) = {(n.atLevel cut.level x).asProcess.response s}) ↔ cut.ReadsExactly n := by
  constructor
  · refine fun hall => ⟨h, fun m hm => ?_⟩
    obtain ⟨x, rfl⟩ := n.exists_atLevel hm
    exact (Process.imageAtScale_singleton_iff _ _).mp (hall x)
  · exact fun hr x s => (Process.imageAtScale_singleton_iff _ _).mpr (hr.responses _ (n.atLevel_atDepth _ x)) s

/-- **A cut, its span.** On finite states and a finite span, a cut's states are finite, so each theorem of a finite `S` applies at them: several histories read together are one case of a larger finite set of states. -/
theorem Cut.finite_states [Finite S] [Finite τ] (cut : Cut S τ) : Finite cut.States :=
  inferInstance

/-! ## Residue at a cut -/

/-- **Claim 17 (Every level, every join), its residue.** The pairs of the histories' joint states a cut identifies: those its reading, taken as one process, does not tell apart. They are read before the scale, so that a pair the scale identifies is a pair still. -/
def Cut.identified (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) : Set (Sym2 (τ → S)) :=
  kernel fun f => (cut.read h).asProcess.constitutive (cut.pull f)

/-- **Claim 17 (Every level, every join), its residue.** The residue at a cut: the number of pairs of distinct joint states it identifies. -/
noncomputable def Cut.residue (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) : ℕ :=
  Companion.residue fun f => (cut.read h).asProcess.constitutive (cut.pull f)

/-- A cut identifies a pair of joint states exactly when, at each history and each arrangement at its level, the partition of what that arrangement and the scale identify holds their states. -/
theorem Cut.mem_identified_iff (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) (f g : τ → S) :
    s(f, g) ∈ cut.identified h ↔ ∀ m, n.AtDepth cut.level m → ∀ t, m.asProcess.atScaleSetoid cut.scale (f t) (g t) := by
  refine (mem_kernel _ f g).trans ⟨fun h0 m hm t => ?_, fun h0 => ?_⟩
  · obtain ⟨x, rfl⟩ := n.exists_atLevel hm
    have h1 : Quotient.mk ((n.atLevel cut.level x).asProcess.atScaleSetoid cut.scale) (f t) = Quotient.mk _ (g t) :=
      congrFun (congrFun h0 x) t
    exact Quotient.exact h1
  · funext x t
    exact Quotient.sound (s := (n.atLevel cut.level x).asProcess.atScaleSetoid cut.scale) (h0 _ (n.atLevel_atDepth _ x) t)

/-- **Claim 17 (Every level, every join), its residue.** A cut identifies a pair of joint states exactly when their states at the cut are one, or lie in the between of what it reads. So the residue at a cut counts that between's pairs read back before the scale, with the pairs the scale itself makes one, which is why it does not shrink as that between's size can (`residue_on_coarse_states_can_shrink`). -/
theorem Cut.mem_identified_iff_between (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) (f g : τ → S) :
    s(f, g) ∈ cut.identified h ↔ cut.pull f = cut.pull g ∨ s(cut.pull f, cut.pull g) ∈ (cut.read h).between := by
  have hkernel : s(f, g) ∈ cut.identified h ↔ s(cut.pull f, cut.pull g) ∈ (cut.read h).asProcess.constitution :=
    (mem_kernel _ f g).trans (mem_kernel (cut.read h).asProcess.constitutive.map _ _).symm
  rw [hkernel]
  constructor
  · intro hin
    by_cases heq : cut.pull f = cut.pull g
    · exact Or.inl heq
    · exact Or.inr ⟨fun hd => heq (Sym2.mk_isDiag_iff.mp hd), (mem_constitution_asProcess _ _).mp hin⟩
  · rintro (heq | hb)
    · exact mem_kernel_of_isDiag _ (Sym2.mk_isDiag_iff.mpr heq)
    · exact (mem_constitution_asProcess _ _).mpr hb.2

/-- **Claim 17 (Every level, every join), its residue.** At a scale that identifies nothing, a cut identifies a pair of joint states exactly when at each history their states are one or lie in the between at its level. So at such a scale and over one history, the pairs of distinct joint states a cut identifies are the pairs of the between at that level, read back one for one. -/
theorem Cut.mem_identified_iff_betweenAt (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) (hc : Function.Injective cut.scale) (f g : τ → S) :
    s(f, g) ∈ cut.identified h ↔ ∀ t, f t = g t ∨ s(f t, g t) ∈ n.betweenAt cut.level := by
  have hstep : ∀ (m : Nested S) (s u : S), m.asProcess.atScaleSetoid cut.scale s u ↔ s(s, u) ∈ m.asProcess.constitution := by
    intro m s u
    constructor
    · intro hset
      have hker : kernel cut.scale ⊆ m.asProcess.constitution := by
        intro z hz
        induction z with
        | _ a b =>
          have hab : a = b := hc ((mem_kernel _ a b).mp hz)
          exact mem_constitution_of_isDiag _ (Sym2.mk_isDiag_iff.mpr hab)
      exact (mem_kernel _ s u).mpr (m.asProcess.atScaleSetoid_le cut.scale m.asProcess.constitutive.map (fun _ hy => hy) hker hset)
    · intro hin
      exact (le_sup_left : Setoid.ker m.asProcess.constitutive.map ≤ m.asProcess.atScaleSetoid cut.scale) ((mem_kernel _ s u).mp hin)
  refine (cut.mem_identified_iff h f g).trans ⟨fun hall t => ?_, fun hall m hm t => ?_⟩
  · by_cases heq : f t = g t
    · exact Or.inl heq
    · refine Or.inr ⟨fun hd => heq (Sym2.mk_isDiag_iff.mp hd), fun m hm p hp => ?_⟩
      exact (Nested.mem_constitution_asProcess m _).mp ((hstep m _ _).mp (hall m hm t)) p hp
  · refine (hstep m _ _).mpr ?_
    rcases hall t with heq | hb
    · exact mem_constitution_of_isDiag _ (Sym2.mk_isDiag_iff.mpr heq)
    · exact (Nested.mem_constitution_asProcess m _).mpr (hb.2 m hm)

/-- **Claim 17 (Every level, every join), what a reading leaves of an attachment.** At a scale that identifies nothing and over one history, a quantity of the cut's states separates a pair in the between of what the cut reads exactly when, read back on the states, it separates a pair in the between at the cut's level: Claim 12 (Change by attachment)'s premise, there and back. Only from the level to the reading does this reach every scale (`separates_from_level_at_any_scale`). From the reading to the level it fails at a coarser scale where several arrangements stand, so a reading's premise can appear with no counterpart at the level (`reading_between_exceeds_level`). -/
theorem Cut.separates_between_read_iff (cut : Cut S Unit) {n : Nested S} (h : cut.Stands n) (hc : Function.Injective cut.scale) {Q : Type} (q' : cut.States → Q) :
    (∃ z ∈ (cut.read h).between, Separates q' z) ↔ ∃ z ∈ n.betweenAt cut.level, Separates (fun s => q' (cut.pull fun _ => s)) z := by
  have hpull : ∀ x : cut.States, ∃ s, cut.pull (fun _ => s) = x := fun x => by
    obtain ⟨s, hs⟩ := Quotient.exists_rep (x ())
    exact ⟨s, funext fun _ => hs⟩
  constructor
  · rintro ⟨z, hz, hsep⟩
    induction z with
    | _ x y =>
      obtain ⟨a, rfl⟩ := hpull x
      obtain ⟨b, rfl⟩ := hpull y
      have hid := (cut.mem_identified_iff_between h (fun _ => a) (fun _ => b)).mpr (Or.inr hz)
      rcases (cut.mem_identified_iff_betweenAt h hc _ _).mp hid () with hab | hb
      · exact absurd (Sym2.mk_isDiag_iff.mpr (congrArg (fun u => cut.pull fun _ => u) hab)) hz.1
      · exact ⟨s(a, b), hb, fun hk => hsep ((mem_kernel q' _ _).mpr ((mem_kernel _ a b).mp hk))⟩
  · rintro ⟨z, hz, hsep⟩
    induction z with
    | _ a b =>
      have hid := (cut.mem_identified_iff_betweenAt h hc (fun _ => a) (fun _ => b)).mpr fun _ => Or.inr hz
      rcases (cut.mem_identified_iff_between h _ _).mp hid with heq | hb
      · have hab : a = b := hc ((coarsen_eq_iff _).mp (congrFun heq ()))
        exact absurd (Sym2.mk_isDiag_iff.mpr hab) hz.1
      · exact ⟨_, hb, fun hk => hsep ((mem_kernel _ a b).mpr ((mem_kernel q' _ _).mp hk))⟩

/-- **Claim 17 (Every level, every join), an attachment from the level to the reading, at any scale.** Over one history, a quantity of the cut's states that, read back on the states, separates a pair in the between at the cut's level separates a pair in the between of what the cut reads. The other way needs more (`reading_between_exceeds_level`). -/
theorem separates_from_level_at_any_scale (cut : Cut S Unit) {n : Nested S} (h : cut.Stands n) {Q : Type} (q' : cut.States → Q)
    (hz : ∃ z ∈ n.betweenAt cut.level, Separates (fun s => q' (cut.pull fun _ => s)) z) : ∃ z ∈ (cut.read h).between, Separates q' z := by
  obtain ⟨z, hz, hsep⟩ := hz
  induction z with
  | _ a b =>
    have hne : cut.pull (fun _ => a) ≠ cut.pull (fun _ => b) := fun heq => hsep ((mem_kernel _ a b).mpr (congrArg q' heq))
    have hid : s((fun _ => a : Unit → S), (fun _ => b : Unit → S)) ∈ cut.identified h := by
      refine (cut.mem_identified_iff h _ _).mpr fun m hm _ => ?_
      exact (le_sup_left : Setoid.ker m.asProcess.constitutive.map ≤ m.asProcess.atScaleSetoid cut.scale)
        ((mem_kernel _ _ _).mp ((Nested.mem_constitution_asProcess m _).mpr fun p hp => hz.2 m hm p hp))
    rcases (cut.mem_identified_iff_between h _ _).mp hid with heq | hb
    · exact absurd heq hne
    · exact ⟨_, hb, fun hk => hsep ((mem_kernel _ a b).mpr ((mem_kernel q' _ _).mp hk))⟩

/-- A larger kernel holds at least as many pairs of distinct states, on finite states. -/
theorem residue_le_of_kernel_subset {X C D : Type} [Finite X] {c : X → C} {d : X → D} (h : kernel c ⊆ kernel d) : Companion.residue c ≤ Companion.residue d :=
  Set.ncard_le_ncard (fun _ hz => ⟨h hz.1, hz.2⟩) (Set.toFinite _)

/-- A kernel strictly larger on a pair of distinct states holds more pairs of distinct states, on finite states. -/
theorem residue_lt_of_kernel_subset {X C D : Type} [Finite X] {c : X → C} {d : X → D} (h : kernel c ⊆ kernel d) {z : Sym2 X} (hd : ¬ z.IsDiag) (hin : z ∈ kernel d) (hout : z ∉ kernel c) :
    Companion.residue c < Companion.residue d :=
  Set.ncard_lt_ncard ⟨fun _ hy => ⟨h hy.1, hy.2⟩, fun hsub => hout (hsub ⟨hin, hd⟩).1⟩ (Set.toFinite _)

/-- A coarser scale at one level identifies what the finer one does, at every arrangement there. -/
theorem Cut.identified_subset_of_same_level {a b : Cut S τ} {n : Nested S} (hl : a.level = b.level) (hs : kernel b.scale ⊆ kernel a.scale) (ha : a.Stands n) (hb : b.Stands n) :
    b.identified hb ⊆ a.identified ha := by
  intro z hz
  induction z with
  | _ f g =>
    refine (a.mem_identified_iff ha f g).mpr fun m hm t => ?_
    have hstep := (b.mem_identified_iff hb f g).mp hz m (hl ▸ hm) t
    refine (sup_le_sup_left ?_ _ : m.asProcess.atScaleSetoid b.scale ≤ m.asProcess.atScaleSetoid a.scale) hstep
    intro s u hsu
    exact (mem_kernel a.scale s u).mp (hs ((mem_kernel b.scale s u).mpr hsu))

/-- **Claim 17 (Every level, every join), its residue.** At one level and over one span, residue cannot shrink under a coarser scale. -/
theorem Cut.residue_le_of_same_level [Finite S] [Finite τ] {a b : Cut S τ} {n : Nested S} (hl : a.level = b.level) (hs : kernel b.scale ⊆ kernel a.scale) (ha : a.Stands n) (hb : b.Stands n) :
    b.residue hb ≤ a.residue ha :=
  residue_le_of_kernel_subset (Cut.identified_subset_of_same_level hl hs ha hb)

/-- **Claim 17 (Every level, every join), the condition on a coarser level.** Every position of a nested arrangement is an arrangement that stands as the process there, and that process is no finer than its members together. It separates no pair all its members identify, as
Claim 1 (Inherited, not emergent) says of what is composed from them. -/
def Nested.EachPositionComposed (m : Nested S) : Prop :=
  ∀ i, ∃ m', m.inner i = some m' ∧ m'.self = m.level.process i ∧ m'.asProcess.constitution ⊆ m'.self.constitution

/-- What stands inside an arrangement at a depth stands one depth further in. -/
theorem Nested.AtDepth.inside_of {n m : Nested S} {d : ℕ} (hm : n.AtDepth d m) : ∀ (i : m.Positions) (m' : Nested S), m.inner i = some m' → n.AtDepth (d + 1) m' := by
  induction hm with
  | here n =>
    intro i m' hi
    cases n with
    | mk self level inner => exact .inside hi (.here _)
  | inside hi' _ ih =>
    intro i m' hi
    exact .inside hi' (ih i m' hi)

/-- One step of a coarser level: where each arrangement at a depth has each position composed, the between one depth further in lies in the between at that depth. -/
theorem Nested.betweenAt_succ_subset {n : Nested S} {d : ℕ} (hn : ∀ m, n.AtDepth d m → m.EachPositionComposed) : n.betweenAt (d + 1) ⊆ n.betweenAt d := by
  rintro z ⟨hd, hall⟩
  refine ⟨hd, fun m hm p hp => ?_⟩
  have hheld : ∃ i, m.level.process i = p := by
    cases m with
    | mk self level inner => exact hp
  obtain ⟨i, rfl⟩ := hheld
  obtain ⟨m', hi, hself, hsub⟩ := hn m hm i
  rw [← hself]
  exact hsub ((Nested.mem_constitution_asProcess m' z).mpr (hall m' (hm.inside_of i m' hi)))

/-- Where each arrangement from a depth down to a deeper one has each position composed, the between at the deeper level lies in the between at the shallower. -/
theorem Nested.betweenAt_subset_of_le {n : Nested S} {d e : ℕ} (hde : d ≤ e) (hn : ∀ k, d ≤ k → k < e → ∀ m, n.AtDepth k m → m.EachPositionComposed) : n.betweenAt e ⊆ n.betweenAt d := by
  induction e, hde using Nat.le_induction with
  | base => exact subset_rfl
  | succ e hde ih =>
    exact (Nested.betweenAt_succ_subset (hn e hde (Nat.lt_succ_self e))).trans (ih fun k hk hke => hn k hk (Nat.lt_succ_of_lt hke))

/-- A coarser cut identifies what the finer one does, where the positions from the shallower level down are composed, and where the finer cut's scale identifies only what each process it reads does not tell apart. -/
theorem Cut.identified_subset_of_coarser {a b : Cut S τ} {n : Nested S} (hab : a.Coarser b) (ha : a.Stands n) (hb : b.Stands n)
    (hnest : ∀ k, a.level ≤ k → k < b.level → ∀ m, n.AtDepth k m → m.EachPositionComposed)
    (hinside : ∀ m, n.AtDepth b.level m → kernel b.scale ⊆ m.asProcess.constitution) : b.identified hb ⊆ a.identified ha := by
  intro z hz
  induction z with
  | _ f g =>
    refine (a.mem_identified_iff ha f g).mpr fun m hm t => ?_
    have hdeep : ∀ m', n.AtDepth b.level m' → s(f t, g t) ∈ m'.asProcess.constitution := fun m' hm' =>
      (mem_kernel _ _ _).mpr (m'.asProcess.atScaleSetoid_le b.scale m'.asProcess.constitutive.map (fun _ hy => hy) (hinside m' hm') ((b.mem_identified_iff hb f g).mp hz m' hm' t))
    have hshallow : s(f t, g t) ∈ m.asProcess.constitution := by
      by_cases hd : (s(f t, g t) : Sym2 S).IsDiag
      · exact mem_constitution_of_isDiag _ hd
      · have hin : s(f t, g t) ∈ n.betweenAt b.level :=
          ⟨hd, fun m' hm' p hp => (Nested.mem_constitution_asProcess m' _).mp (hdeep m' hm') p hp⟩
        have hup := Nested.betweenAt_subset_of_le hab.1 hnest hin
        exact (Nested.mem_constitution_asProcess m _).mpr (hup.2 m hm)
    exact (le_sup_left : Setoid.ker m.asProcess.constitutive.map ≤ m.asProcess.atScaleSetoid a.scale) ((mem_kernel _ _ _).mp hshallow)

/-- **Claim 17 (Every level, every join), its residue.** Over one span, residue cannot shrink under a coarser cut, where from the shallower level down every position is an arrangement that as a process is no finer than its members together, and where the finer cut's scale identifies
only pairs each process it reads does not tell apart. `coarser_level_can_shrink` and `coarser_cut_can_shrink_at_scale` show that each condition, dropped, can fail, and `condition_not_necessary` that neither is necessary. -/
theorem Cut.residue_le_of_coarser [Finite S] [Finite τ] {a b : Cut S τ} {n : Nested S} (hab : a.Coarser b) (ha : a.Stands n) (hb : b.Stands n)
    (hnest : ∀ k, a.level ≤ k → k < b.level → ∀ m, n.AtDepth k m → m.EachPositionComposed)
    (hinside : ∀ m, n.AtDepth b.level m → kernel b.scale ⊆ m.asProcess.constitution) : b.residue hb ≤ a.residue ha :=
  residue_le_of_kernel_subset (Cut.identified_subset_of_coarser hab ha hb hnest hinside)

/-! ## The witnesses of residue -/

/-- A nested arrangement of one process and no nesting. -/
def Nested.flat (p : Process S) : Nested S :=
  .mk p ⟨inferInstance, fun _ : Unit => p, ∅⟩ fun _ => none

/-- At depth zero stands a nested arrangement itself. -/
theorem Nested.exists_atDepth_zero (n : Nested S) : ∃ m, n.AtDepth 0 m :=
  ⟨n, .here n⟩

/-- A cut of two states and one history at a given level, with a scale that identifies nothing. -/
def bitCut (d : ℕ) : Cut Bool Unit :=
  ⟨d, Bool, id⟩

/-- The two joint states of one history of a bit, a pair of distinct states. -/
abbrev bitPair : Sym2 (Unit → Bool) :=
  s(fun _ => false, fun _ => true)

/-- The two joint states of one history of a bit are distinct. -/
theorem not_isDiag_bitPair : ¬ bitPair.IsDiag := by
  rw [Sym2.mk_isDiag_iff]
  exact fun h => Bool.false_ne_true (congrFun h ())

/-- At a scale that identifies nothing, a cut of a bit identifies only a pair each process tells apart nowhere: where an arrangement at the level has a process telling the bits apart, the bit pair is not identified. -/
theorem bitPair_not_mem {d : ℕ} {n : Nested Bool} (h : (bitCut d).Stands n) {m p} (hm : n.AtDepth d m) (hp : m.HoldsProcess p) (htell : s(false, true) ∉ p.constitution) :
    bitPair ∉ (bitCut d).identified h := by
  intro hin
  have hset := ((bitCut d).mem_identified_iff h _ _).mp hin m hm ()
  have hk : m.asProcess.atScaleSetoid (bitCut d).scale ≤ Setoid.ker m.asProcess.constitutive.map := by
    refine sup_le le_rfl ?_
    intro s t hst
    have : s = t := hst
    rw [this]
  exact htell ((Nested.mem_constitution_asProcess m _).mp ((mem_kernel _ _ _).mpr (hk hset)) p hp)

/-- At a scale that identifies nothing, a cut of a bit identifies the bit pair where every process at its level does not tell the bits apart. -/
theorem bitPair_mem {d : ℕ} {n : Nested Bool} (h : (bitCut d).Stands n) (hall : ∀ m, n.AtDepth d m → ∀ p, m.HoldsProcess p → s(false, true) ∈ p.constitution) :
    bitPair ∈ (bitCut d).identified h := by
  refine ((bitCut d).mem_identified_iff h _ _).mpr fun m hm _ => ?_
  exact (le_sup_left : Setoid.ker m.asProcess.constitutive.map ≤ m.asProcess.atScaleSetoid (bitCut d).scale)
    ((mem_kernel _ _ _).mp ((Nested.mem_constitution_asProcess m _).mpr (hall m hm)))

/-- A cut of a bit with one history identifies a pair only if the bit pair or a pair of one state: there is no other pair. -/
theorem bit_kernel_subset {d e : ℕ} {n : Nested Bool} (ha : (bitCut d).Stands n) (hb : (bitCut e).Stands n) (hout : bitPair ∉ (bitCut d).identified ha) :
    (bitCut d).identified ha ⊆ (bitCut e).identified hb := by
  intro z hz
  induction z with
  | _ f g =>
    by_cases hfg : f = g
    · exact mem_kernel_of_isDiag _ (Sym2.mk_isDiag_iff.mpr hfg)
    · exfalso
      apply hout
      have hval : f () ≠ g () := fun h => hfg (funext fun _ => h)
      have hf : f = fun _ => f () := rfl
      have hg : g = fun _ => g () := rfl
      cases hfv : f () <;> cases hgv : g ()
      · exact absurd (by rw [hfv, hgv]) hval
      · rw [hf, hg, hfv, hgv] at hz
        exact hz
      · rw [hf, hg, hfv, hgv, Sym2.eq_swap] at hz
        exact hz
      · exact absurd (by rw [hfv, hgv]) hval

/-- **Claim 17 (Every level, every join), its residue.** Residue can grow under a coarser scale, and both cuts read exactly. On two states and one history, a process tells the states apart and has a constant response, so a scale that identifies them still has its exact response. At the scale that identifies nothing it identifies no pair, and at that scale it identifies one. -/
theorem residue_can_grow_by_scale :
    ∃ (S : Type) (_ : Fintype S) (n : Nested S) (a b : Cut S Unit) (ha : a.Stands n) (hb : b.Stands n), a.ReadsExactly n ∧ b.ReadsExactly n ∧ a.Coarser b ∧ b.residue hb < a.residue ha := by
  let p : Process Bool := (Process.reading id).withRule fun _ => ()
  let n : Nested Bool := Nested.flat p
  let a : Cut Bool Unit := ⟨0, Unit, fun _ => ()⟩
  have ha : a.ReadsExactly n := ⟨n.exists_atDepth_zero, fun m hm z _ => by
    obtain rfl := Nested.eq_of_atDepth_zero hm
    exact mem_kernel_const (fun _ : Unit => ()) z⟩
  have hb : (bitCut 0).ReadsExactly n := (bitCut 0).readsExactly_of_injective n.exists_atDepth_zero Function.injective_id
  have hs : kernel (bitCut 0).scale ⊆ kernel a.scale := fun z _ => mem_kernel_const () z
  refine ⟨Bool, inferInstance, n, a, bitCut 0, ha.level, hb.level, ha, hb, ⟨le_rfl, hs⟩, ?_⟩
  refine residue_lt_of_kernel_subset (Cut.identified_subset_of_same_level (a := a) (b := bitCut 0) rfl hs ha.level hb.level) not_isDiag_bitPair ?_ ?_
  · refine (a.mem_identified_iff ha.level _ _).mpr fun m _ _ => ?_
    exact (le_sup_right : Setoid.ker a.scale ≤ m.asProcess.atScaleSetoid a.scale) rfl
  · exact bitPair_not_mem hb.level (.here n) ⟨(), rfl⟩ fun hin => Bool.false_ne_true ((mem_kernel id false true).mp hin)

/-- A process reading the bit tells the bits apart. -/
theorem bit_not_mem_constitution : s(false, true) ∉ (Process.reading id : Process Bool).constitution :=
  fun hin => Bool.false_ne_true ((mem_kernel id false true).mp hin)

/-- **Claim 17 (Every level, every join), its residue.** Residue can grow under a coarser level, with the scale fixed, and both cuts read exactly. On two states, an inner arrangement holds a process that tells nothing apart and one that tells the states apart, and as a process above it tells nothing apart. Read at the level above the pair is
identified, and read at its own level it is not. -/
theorem residue_can_grow_by_level :
    ∃ (S : Type) (_ : Fintype S) (n : Nested S) (a b : Cut S Unit) (ha : a.Stands n) (hb : b.Stands n), a.ReadsExactly n ∧ b.ReadsExactly n ∧ a.Coarser b ∧ n.Coherent ∧ b.residue hb < a.residue ha := by
  let n : Nested Bool := tower Process.blank (Process.reading id) fun _ => ()
  have hdepth : n.AtDepth 1 (towerInner Process.blank (Process.reading id) fun _ => ()) := tower_atDepth _ _ _
  have ha : (bitCut 0).Stands n := n.exists_atDepth_zero
  have hb : (bitCut 1).Stands n := ⟨_, hdepth⟩
  have hout : bitPair ∉ (bitCut 1).identified hb :=
    bitPair_not_mem hb hdepth ⟨false, rfl⟩ bit_not_mem_constitution
  have hin : bitPair ∈ (bitCut 0).identified ha := by
    refine bitPair_mem ha fun m hm p hp => ?_
    obtain rfl := Nested.eq_of_atDepth_zero hm
    obtain ⟨_, rfl⟩ := hp
    exact mem_kernel_const () _
  exact ⟨Bool, inferInstance, n, bitCut 0, bitCut 1, ha, hb, (bitCut 0).readsExactly_of_injective ha Function.injective_id, (bitCut 1).readsExactly_of_injective hb Function.injective_id,
    ⟨Nat.zero_le 1, subset_rfl⟩, tower_coherent _ _ _, residue_lt_of_kernel_subset (bit_kernel_subset hb ha hout) not_isDiag_bitPair hin hout⟩

/-- The step of the witnesses of a coarser level that shrinks: on two states, where a process at depth zero tells the states apart, and at depth one an arrangement stands and no process tells them apart, residue at depth zero is below residue at depth one. -/
theorem residue_lt_of_level_tells {n : Nested Bool} {p : Process Bool} (hp : n.HoldsProcess p) (htell : s(false, true) ∉ p.constitution) (hl : (bitCut 1).Stands n)
    (hdeep : ∀ m, n.AtDepth 1 m → ∀ p, m.HoldsProcess p → s(false, true) ∈ p.constitution) :
    ∃ (ha : (bitCut 0).Stands n) (hb : (bitCut 1).Stands n), (bitCut 0).residue ha < (bitCut 1).residue hb := by
  have ha : (bitCut 0).Stands n := n.exists_atDepth_zero
  have hout := bitPair_not_mem ha (.here n) hp htell
  exact ⟨ha, hl, residue_lt_of_kernel_subset (bit_kernel_subset ha hl hout) not_isDiag_bitPair (bitPair_mem hl hdeep) hout⟩

/-- **Claim 17 (Every level, every join), the level's condition, dropped.** "Under a coarser cut residue cannot shrink" can fail for a level no deeper, in each of the two ways the condition `Nested.EachPositionComposed` can fail, with a scale that identifies nothing, and each conjunct says which. First, a position that holds a plain process: on two states, it tells them apart at depth
zero, beside an arrangement that tells nothing apart, and at depth one it is not read. Second, an arrangement that as a process is finer than its members together: it tells the states apart above, and its members tell nothing apart. In each, residue shrinks at the coarser cut. -/
theorem coarser_level_can_shrink :
    (∃ (n : Nested Bool) (ha : (bitCut 0).Stands n) (hb : (bitCut 1).Stands n), (bitCut 0).Coarser (bitCut 1) ∧ n.Coherent ∧ (bitCut 0).residue ha < (bitCut 1).residue hb ∧
        ∃ i, n.inner i = none) ∧
      ∃ (n : Nested Bool) (ha : (bitCut 0).Stands n) (hb : (bitCut 1).Stands n), (bitCut 0).Coarser (bitCut 1) ∧ n.Coherent ∧ (bitCut 0).residue ha < (bitCut 1).residue hb ∧
        ∃ i m, n.inner i = some m ∧ m.self = n.level.process i ∧ ¬ m.asProcess.constitution ⊆ m.self.constitution := by
  have hcoarser : (bitCut 0).Coarser (bitCut 1) := ⟨Nat.zero_le 1, subset_rfl⟩
  constructor
  · let m : Nested Bool := Nested.flat Process.blank
    let n : Nested Bool := .mk Process.blank ⟨inferInstance, fun b : Bool => cond b Process.blank (Process.reading id), ∅⟩ fun b => cond b (some m) none
    have hcoh : n.Coherent := by
      refine .mk (fun i k hi => ?_) (fun i k hi => ?_)
      · cases i with
        | true =>
          obtain rfl : m = k := Option.some.inj hi
          rfl
        | false => exact absurd hi (by simp)
      · cases i with
        | true =>
          obtain rfl : m = k := Option.some.inj hi
          exact .mk (fun _ _ h => absurd h (by simp)) (fun _ _ h => absurd h (by simp))
        | false => exact absurd hi (by simp)
    have hat : n.AtDepth 1 m := .inside (i := true) rfl (.here m)
    have hdeep : ∀ k, n.AtDepth 1 k → ∀ p, k.HoldsProcess p → s(false, true) ∈ p.constitution := by
      intro k hk p hp
      obtain ⟨i, hi⟩ := Nested.atDepth_one_iff.mp hk
      cases i with
      | true =>
        obtain rfl : m = k := Option.some.inj hi
        obtain ⟨_, rfl⟩ := hp
        exact mem_constitution_blank _
      | false => exact absurd hi (by simp)
    obtain ⟨ha, hb, hlt⟩ := residue_lt_of_level_tells (n := n) (p := Process.reading id) ⟨false, rfl⟩ bit_not_mem_constitution ⟨m, hat⟩ hdeep
    exact ⟨n, ha, hb, hcoarser, hcoh, hlt, (false : Bool), rfl⟩
  · let top : Process Bool := Process.reading id
    let m : Nested Bool := .mk top ⟨inferInstance, fun _ : Unit => Process.blank, ∅⟩ fun _ => none
    let n : Nested Bool := .mk top ⟨inferInstance, fun _ : Unit => top, ∅⟩ fun _ => some m
    have hcoh : n.Coherent := by
      refine .mk (fun _ k hi => ?_) (fun _ k hi => ?_)
      · obtain rfl : m = k := Option.some.inj hi
        rfl
      · obtain rfl : m = k := Option.some.inj hi
        exact .mk (fun _ _ h => absurd h (by simp)) (fun _ _ h => absurd h (by simp))
    have hat : n.AtDepth 1 m := .inside (i := ()) rfl (.here m)
    have hdeep : ∀ k, n.AtDepth 1 k → ∀ p, k.HoldsProcess p → s(false, true) ∈ p.constitution := by
      intro k hk p hp
      obtain ⟨_, hi⟩ := Nested.atDepth_one_iff.mp hk
      obtain rfl : m = k := Option.some.inj hi
      obtain ⟨_, rfl⟩ := hp
      exact mem_constitution_blank _
    obtain ⟨ha, hb, hlt⟩ := residue_lt_of_level_tells (n := n) (p := top) ⟨(), rfl⟩ bit_not_mem_constitution ⟨m, hat⟩ hdeep
    refine ⟨n, ha, hb, hcoarser, hcoh, hlt, (), m, rfl, rfl, fun hsub => bit_not_mem_constitution (hsub ?_)⟩
    refine (Nested.mem_constitution_asProcess m _).mpr fun p hp => ?_
    obtain ⟨_, rfl⟩ := hp
    exact mem_constitution_blank _

/-- The first process of the witness that a scale can shrink: it identifies states 0 and 1. -/
def scaleLeft : Fin 3 → Bool :=
  ![false, false, true]

/-- The second process of that witness: it identifies states 1 and 2. -/
def scaleRight : Fin 3 → Bool :=
  ![false, true, true]

/-- The scale of that witness: it identifies states 0 and 2. -/
def scaleMiddle : Fin 3 → Bool :=
  ![false, true, false]

/-- A process of that witness: constituted to make a coarse-graining, with a constant response, so any scale reads it. -/
def Process.silent {C : Type} (c : S → C) : Process S :=
  (Process.reading c).withRule fun _ => ()

/-- The arrangement holding one silent process. -/
def silentInner {C : Type} (c : S → C) : Nested S :=
  Nested.flat (Process.silent c)

/-- The nested arrangement of that witness: two arrangements at depth one, each holding one silent process, each the process at its position above. -/
def scaleNested : Nested (Fin 3) :=
  .mk (Process.blank) ⟨inferInstance, fun b : Bool => cond b (Process.silent scaleLeft) (Process.silent scaleRight), ∅⟩
    fun b => cond b (some (silentInner scaleLeft)) (some (silentInner scaleRight))

/-- At depth one of that witness stand its two arrangements. -/
theorem scaleNested_atDepth_one {m : Nested (Fin 3)} (hm : scaleNested.AtDepth 1 m) : m = silentInner scaleLeft ∨ m = silentInner scaleRight := by
  obtain ⟨i, hi⟩ := Nested.atDepth_one_iff.mp hm
  cases i with
  | true => exact Or.inl (Option.some.inj hi).symm
  | false => exact Or.inr (Option.some.inj hi).symm

/-- The scale of that witness as a cut at a given level. -/
def middleCut (d : ℕ) : Cut (Fin 3) Unit :=
  ⟨d, Bool, scaleMiddle⟩

/-- A silent arrangement is read at any scale. -/
theorem kernel_response_silent {C D : Type} (c : S → C) (d : S → D) : kernel d ⊆ kernel (silentInner c).asProcess.response := by
  intro z _
  refine (Nested.mem_kernel_response_asProcess _ z).mpr fun p hp => ?_
  obtain ⟨_, rfl⟩ := hp
  exact mem_kernel_const () z

/-- **Claim 17 (Every level, every join), the scale's condition, dropped.** "Under a coarser cut residue cannot shrink" can fail for a level no deeper at a scale that identifies pairs the finer cut's processes tell apart, though every position is composed. Two arrangements at depth one each tell apart less than
the scale can hide: read one by one at the scale each tells nothing apart, and taken together above they tell two coarse values apart. So the same scale read at the shallower level identifies fewer pairs, since a partition's join does not distribute over its meet. -/
theorem coarser_cut_can_shrink_at_scale :
    ∃ (ha : (middleCut 0).Stands scaleNested) (hb : (middleCut 1).Stands scaleNested), (middleCut 0).ReadsExactly scaleNested ∧ (middleCut 1).ReadsExactly scaleNested ∧ (middleCut 0).Coarser (middleCut 1) ∧ scaleNested.Coherent ∧
      (∀ m, scaleNested.AtDepth 0 m → m.EachPositionComposed) ∧ (middleCut 0).residue ha < (middleCut 1).residue hb := by
  have ha0 : (middleCut 0).ReadsExactly scaleNested := by
    refine ⟨scaleNested.exists_atDepth_zero, fun m hm z _ => ?_⟩
    obtain rfl := Nested.eq_of_atDepth_zero hm
    refine (Nested.mem_kernel_response_asProcess _ z).mpr fun p hp => ?_
    obtain ⟨i, rfl⟩ := hp
    cases i <;> exact mem_kernel_const () z
  have hb0 : (middleCut 1).ReadsExactly scaleNested := by
    refine ⟨⟨_, Nested.AtDepth.inside (i := true) rfl (.here _)⟩, fun m hm z hz => ?_⟩
    rcases scaleNested_atDepth_one hm with rfl | rfl
    · exact kernel_response_silent _ _ hz
    · exact kernel_response_silent _ _ hz
  have ha : (middleCut 0).Stands scaleNested := ha0.level
  have hb : (middleCut 1).Stands scaleNested := hb0.level
  have hcomposed : ∀ m, scaleNested.AtDepth 0 m → m.EachPositionComposed := by
    intro m hm i
    obtain rfl := Nested.eq_of_atDepth_zero hm
    cases i with
    | true =>
      refine ⟨silentInner scaleLeft, rfl, rfl, fun z hz => ?_⟩
      exact (Nested.mem_constitution_asProcess _ z).mp hz _ ⟨(), rfl⟩
    | false =>
      refine ⟨silentInner scaleRight, rfl, rfl, fun z hz => ?_⟩
      exact (Nested.mem_constitution_asProcess _ z).mp hz _ ⟨(), rfl⟩
  have hcoh : scaleNested.Coherent := by
    refine .mk (fun i k hi => ?_) (fun i k hi => ?_)
    · cases i with
      | true =>
        obtain rfl : silentInner scaleLeft = k := Option.some.inj hi
        rfl
      | false =>
        obtain rfl : silentInner scaleRight = k := Option.some.inj hi
        rfl
    · cases i with
      | true =>
        obtain rfl : silentInner scaleLeft = k := Option.some.inj hi
        exact .mk (fun _ _ h => absurd h (by simp)) (fun _ _ h => absurd h (by simp))
      | false =>
        obtain rfl : silentInner scaleRight = k := Option.some.inj hi
        exact .mk (fun _ _ h => absurd h (by simp)) (fun _ _ h => absurd h (by simp))
  -- what the shallow cut identifies, the deep one does
  have hsub : (middleCut 0).identified ha ⊆ (middleCut 1).identified hb := by
    intro z hz
    induction z with
    | _ f g =>
      refine ((middleCut 1).mem_identified_iff hb f g).mpr fun m hm t => ?_
      have hstep := ((middleCut 0).mem_identified_iff ha f g).mp hz scaleNested (.here _) t
      refine (sup_le ?_ le_sup_right : scaleNested.asProcess.atScaleSetoid scaleMiddle ≤ m.asProcess.atScaleSetoid scaleMiddle) hstep
      intro s u hsu
      have hall : s(s, u) ∈ scaleNested.asProcess.constitution := (mem_kernel _ _ _).mpr hsu
      have hmem := (Nested.mem_constitution_asProcess _ _).mp hall
      refine (le_sup_left : Setoid.ker m.asProcess.constitutive.map ≤ m.asProcess.atScaleSetoid scaleMiddle) ((mem_kernel _ _ _).mp ((Nested.mem_constitution_asProcess m _).mpr fun p hp => ?_))
      rcases scaleNested_atDepth_one hm with rfl | rfl
      · obtain ⟨_, rfl⟩ := hp
        exact hmem _ ⟨true, rfl⟩
      · obtain ⟨_, rfl⟩ := hp
        exact hmem _ ⟨false, rfl⟩
  let x : Sym2 (Unit → Fin 3) := s(fun _ => 0, fun _ => 1)
  have hx : ¬ x.IsDiag := by
    rw [Sym2.mk_isDiag_iff]
    intro h
    exact absurd (congrFun h ()) (by decide)
  have hin : x ∈ (middleCut 1).identified hb := by
    refine ((middleCut 1).mem_identified_iff hb _ _).mpr fun m hm _ => ?_
    have hscale02 : (Setoid.ker scaleMiddle) (0 : Fin 3) 2 := by
      change scaleMiddle 0 = scaleMiddle 2
      decide
    rcases scaleNested_atDepth_one hm with rfl | rfl
    · refine (le_sup_left : Setoid.ker (silentInner scaleLeft).asProcess.constitutive.map ≤ _) ?_
      funext _
      change scaleLeft 0 = scaleLeft 1
      decide
    · have hright : (Setoid.ker (silentInner scaleRight).asProcess.constitutive.map) (2 : Fin 3) 1 := by
        funext _
        change scaleRight 2 = scaleRight 1
        decide
      have h1 : ((silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) (0 : Fin 3) 2 :=
        (le_sup_right : Setoid.ker scaleMiddle ≤ (silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) hscale02
      have h2 : ((silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) (2 : Fin 3) 1 :=
        (le_sup_left : Setoid.ker (silentInner scaleRight).asProcess.constitutive.map ≤ (silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) hright
      exact Setoid.trans' _ h1 h2
  have hout : x ∉ (middleCut 0).identified ha := by
    intro hmem
    have hset := ((middleCut 0).mem_identified_iff ha _ _).mp hmem scaleNested (.here _) ()
    have hle : scaleNested.asProcess.atScaleSetoid scaleMiddle ≤ Setoid.ker scaleMiddle := by
      refine scaleNested.asProcess.atScaleSetoid_le scaleMiddle scaleMiddle (fun z hz => ?_) (fun _ hy => hy)
      induction z with
      | _ s t =>
        have hl : s(s, t) ∈ (Process.silent scaleLeft).constitution := (Nested.mem_constitution_asProcess _ _).mp hz _ ⟨true, rfl⟩
        have hr : s(s, t) ∈ (Process.silent scaleRight).constitution := (Nested.mem_constitution_asProcess _ _).mp hz _ ⟨false, rfl⟩
        have hl' : scaleLeft s = scaleLeft t := (mem_kernel scaleLeft s t).mp hl
        have hr' : scaleRight s = scaleRight t := (mem_kernel scaleRight s t).mp hr
        have hdec : ∀ s t : Fin 3, scaleLeft s = scaleLeft t → scaleRight s = scaleRight t → s = t := by decide
        exact (mem_kernel _ s t).mpr (congrArg scaleMiddle (hdec s t hl' hr'))
    have hne : scaleMiddle 0 = scaleMiddle 1 := hle hset
    exact absurd hne (by decide)
  exact ⟨ha, hb, ha0, hb0, ⟨Nat.zero_le 1, subset_rfl⟩, hcoh, hcomposed, residue_lt_of_kernel_subset hsub hx hin hout⟩

/-- The nested arrangement of the first case of `condition_not_necessary`: two positions, one an arrangement and one a plain process, each telling nothing apart. -/
def plainNested : Nested Bool :=
  .mk Process.blank ⟨inferInstance, fun _ : Bool => Process.blank, ∅⟩ fun b => cond b (some (Nested.flat Process.blank)) none

/-- The nested arrangement of the second case of `condition_not_necessary`: one position, an arrangement holding the process that tells the bits apart. -/
def tellingNested : Nested Bool :=
  .mk (Process.reading id) ⟨inferInstance, fun _ : Unit => Process.reading id, ∅⟩ fun _ => some (Nested.flat (Process.reading id))

/-- **Claim 17 (Every level, every join), the conditions across levels are not necessary.** Under a coarser level residue need not shrink where either condition of `Cut.residue_le_of_coarser` fails with the other standing. First, a position holds a plain process, so the level's condition fails, the scale identifying nothing, and residue does not shrink. Second, every position is composed, the scale identifies a pair the finer cut's process tells apart, so the scale's condition fails, and residue does not shrink. So those conditions are sufficient, and each, dropped, can fail (`coarser_level_can_shrink`, `coarser_cut_can_shrink_at_scale`). -/
theorem condition_not_necessary :
    (∃ (ha : (bitCut 0).Stands plainNested) (hb : (bitCut 1).Stands plainNested),
      (bitCut 0).Coarser (bitCut 1) ∧ plainNested.Coherent ∧ ¬ plainNested.EachPositionComposed ∧ (bitCut 1).residue hb ≤ (bitCut 0).residue ha) ∧
    ∃ (a b : Cut Bool Unit) (ha : a.Stands tellingNested) (hb : b.Stands tellingNested),
      a.Coarser b ∧ a.level < b.level ∧ tellingNested.Coherent ∧ (∀ k, a.level ≤ k → k < b.level → ∀ m, tellingNested.AtDepth k m → m.EachPositionComposed) ∧
      (¬ ∀ m, tellingNested.AtDepth b.level m → kernel b.scale ⊆ m.asProcess.constitution) ∧ b.residue hb ≤ a.residue ha := by
  constructor
  · have hat : plainNested.AtDepth 1 (Nested.flat Process.blank) := .inside (i := true) rfl (.here _)
    have ha : (bitCut 0).Stands plainNested := plainNested.exists_atDepth_zero
    have hb : (bitCut 1).Stands plainNested := ⟨_, hat⟩
    refine ⟨ha, hb, ⟨Nat.zero_le 1, subset_rfl⟩, ?_, ?_, ?_⟩
    · refine .mk (fun i k hi => ?_) (fun i k hi => ?_)
      · cases i with
        | true =>
          obtain rfl : Nested.flat Process.blank = k := Option.some.inj hi
          rfl
        | false => exact absurd hi (by simp)
      · cases i with
        | true =>
          obtain rfl : Nested.flat Process.blank = k := Option.some.inj hi
          exact .mk (fun _ _ h => absurd h (by simp)) (fun _ _ h => absurd h (by simp))
        | false => exact absurd hi (by simp)
    · intro h
      obtain ⟨m', hi, -⟩ := h (false : Bool)
      have hi' : (none : Option (Nested Bool)) = some m' := hi
      cases hi'
    · refine residue_le_of_kernel_subset (c := fun f => ((bitCut 1).read hb).asProcess.constitutive ((bitCut 1).pull f)) (d := fun f => ((bitCut 0).read ha).asProcess.constitutive ((bitCut 0).pull f)) ?_
      intro z _
      induction z with
      | _ f g =>
        refine ((bitCut 0).mem_identified_iff ha f g).mpr fun m hm t => ?_
        obtain rfl := Nested.eq_of_atDepth_zero hm
        refine (le_sup_left : Setoid.ker plainNested.asProcess.constitutive.map ≤ plainNested.asProcess.atScaleSetoid (bitCut 0).scale) ((mem_kernel _ _ _).mp ((Nested.mem_constitution_asProcess _ _).mpr fun p hp => ?_))
        obtain ⟨_, rfl⟩ := hp
        exact mem_constitution_blank _
  · let m : Nested Bool := Nested.flat (Process.reading id)
    let a : Cut Bool Unit := ⟨0, Unit, fun _ => ()⟩
    let b : Cut Bool Unit := ⟨1, Unit, fun _ => ()⟩
    have hat : tellingNested.AtDepth 1 m := .inside (i := ()) rfl (.here m)
    have ha : a.Stands tellingNested := tellingNested.exists_atDepth_zero
    have hb : b.Stands tellingNested := ⟨m, hat⟩
    refine ⟨a, b, ha, hb, ⟨Nat.zero_le 1, subset_rfl⟩, Nat.zero_lt_one, ?_, ?_, ?_, ?_⟩
    · refine .mk (fun _ k hi => ?_) (fun _ k hi => ?_)
      · obtain rfl : m = k := Option.some.inj hi
        rfl
      · obtain rfl : m = k := Option.some.inj hi
        exact .mk (fun _ _ h => absurd h (by simp)) (fun _ _ h => absurd h (by simp))
    · intro k _ hk n hn
      obtain rfl : k = 0 := Nat.lt_one_iff.mp hk
      obtain rfl := Nested.eq_of_atDepth_zero hn
      exact fun _ => ⟨m, rfl, rfl, fun z hz => (Nested.mem_constitution_asProcess m z).mp hz _ ⟨(), rfl⟩⟩
    · intro hall
      have hin : s(false, true) ∈ m.asProcess.constitution := hall m hat (mem_kernel_const () _)
      exact bit_not_mem_constitution ((Nested.mem_constitution_asProcess m _).mp hin _ ⟨(), rfl⟩)
    · have hsub : b.identified hb ⊆ a.identified ha := by
        intro z _
        induction z with
        | _ f g =>
          exact (a.mem_identified_iff ha f g).mpr fun n _ _ => (le_sup_right : Setoid.ker a.scale ≤ n.asProcess.atScaleSetoid a.scale) rfl
      exact residue_le_of_kernel_subset hsub

/-- **Claim 17 (Every level, every join), a reading's attachment premise with no counterpart at the level.** Where several arrangements stand at a level, a scale can put a pair in the between of what the cut reads while the between at the level is empty: on `scaleNested` at depth one, the scale identifies states 0 and 2, with it each arrangement there identifies states 0 and 1, and a quantity of the cut's states separates that pair. So `separates_from_level_at_any_scale` has no converse in general. -/
theorem reading_between_exceeds_level :
    ∃ (h : (middleCut 1).Stands scaleNested) (q' : (middleCut 1).States → Fin 3),
      (∃ z ∈ ((middleCut 1).read h).between, Separates q' z) ∧ scaleNested.betweenAt (middleCut 1).level = ∅ := by
  have h : (middleCut 1).Stands scaleNested := ⟨_, Nested.AtDepth.inside (i := true) rfl (.here _)⟩
  let f : Unit → Fin 3 := fun _ => 0
  let g : Unit → Fin 3 := fun _ => 1
  have hne : (middleCut 1).pull f ≠ (middleCut 1).pull g := by
    intro heq
    have : scaleMiddle 0 = scaleMiddle 1 := (coarsen_eq_iff _).mp (congrFun heq ())
    exact absurd this (by decide)
  have hin : s(f, g) ∈ (middleCut 1).identified h := by
    refine ((middleCut 1).mem_identified_iff h _ _).mpr fun m hm _ => ?_
    have hscale02 : (Setoid.ker scaleMiddle) (0 : Fin 3) 2 := by
      change scaleMiddle 0 = scaleMiddle 2
      decide
    rcases scaleNested_atDepth_one hm with rfl | rfl
    · refine (le_sup_left : Setoid.ker (silentInner scaleLeft).asProcess.constitutive.map ≤ _) ?_
      funext _
      change scaleLeft 0 = scaleLeft 1
      decide
    · have hright : (Setoid.ker (silentInner scaleRight).asProcess.constitutive.map) (2 : Fin 3) 1 := by
        funext _
        change scaleRight 2 = scaleRight 1
        decide
      have h1 : ((silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) (0 : Fin 3) 2 :=
        (le_sup_right : Setoid.ker scaleMiddle ≤ (silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) hscale02
      have h2 : ((silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) (2 : Fin 3) 1 :=
        (le_sup_left : Setoid.ker (silentInner scaleRight).asProcess.constitutive.map ≤ (silentInner scaleRight).asProcess.atScaleSetoid scaleMiddle) hright
      exact Setoid.trans' _ h1 h2
  have hb := ((middleCut 1).mem_identified_iff_between h f g).mp hin
  have hb' := hb.resolve_left hne
  classical
  let q' : (middleCut 1).States → Fin 3 := fun x => if x = (middleCut 1).pull f then 0 else 1
  refine ⟨h, q', ⟨_, hb', fun hk => ?_⟩, ?_⟩
  · have hval : q' ((middleCut 1).pull f) = q' ((middleCut 1).pull g) := (mem_kernel q' _ _).mp hk
    have h0 : q' ((middleCut 1).pull f) = 0 := by simp [q']
    have h1 : q' ((middleCut 1).pull g) = 1 := by simp [q', Ne.symm hne]
    rw [h0, h1] at hval
    exact absurd hval (by decide)
  · refine Set.eq_empty_of_forall_notMem fun z hz => ?_
    induction z with
    | _ s t =>
      have hl : s(s, t) ∈ (Process.silent scaleLeft).constitution :=
        hz.2 _ (Nested.AtDepth.inside (i := true) rfl (.here _)) _ ⟨(), rfl⟩
      have hr : s(s, t) ∈ (Process.silent scaleRight).constitution :=
        hz.2 _ (Nested.AtDepth.inside (i := false) rfl (.here _)) _ ⟨(), rfl⟩
      have hl' : scaleLeft s = scaleLeft t := (mem_kernel scaleLeft s t).mp hl
      have hr' : scaleRight s = scaleRight t := (mem_kernel scaleRight s t).mp hr
      have hdec : ∀ s t : Fin 3, scaleLeft s = scaleLeft t → scaleRight s = scaleRight t → s = t := by decide
      exact hz.1 (Sym2.mk_isDiag_iff.mpr (hdec s t hl' hr'))

/-- **Claim 17 (Every level, every join), why residue is read before the scale.** Counted on the coarse states' own pairs, the between of a cut's reading shrinks as the scale coarsens: on two states and a process that tells nothing apart, the scale that identifies nothing leaves one pair in the between, and the scale that
identifies them leaves one coarse state and no pair. So the form's "cannot shrink" is of the pairs before the scale, `Cut.residue`. -/
theorem residue_on_coarse_states_can_shrink :
    ∃ (n : Nested Bool) (a b : Cut Bool Unit) (ha : a.Stands n) (hb : b.Stands n), a.Coarser b ∧ (a.read ha).residue < (b.read hb).residue := by
  let n : Nested Bool := Nested.flat Process.blank
  let a : Cut Bool Unit := ⟨0, Unit, fun _ => ()⟩
  have ha : a.Stands n := n.exists_atDepth_zero
  have hb : (bitCut 0).Stands n := n.exists_atDepth_zero
  have hsingle : ∀ f g : a.States, f = g := by
    intro f g
    funext t
    induction f t using Quotient.inductionOn with
    | _ s =>
      induction g t using Quotient.inductionOn with
      | _ u => exact Quotient.sound (s := Setoid.ker a.scale) rfl
  have hempty : (a.read ha).between = ∅ := by
    refine Set.eq_empty_of_forall_notMem fun z hz => ?_
    induction z with
    | _ f g => exact hz.1 (Sym2.mk_isDiag_iff.mpr (hsingle f g))
  have hne : (bitCut 0).pull (fun _ => false) ≠ (bitCut 0).pull (fun _ => true) := fun h =>
    Bool.false_ne_true ((coarsen_eq_iff _).mp (congrFun h ()))
  have hmem : s((bitCut 0).pull (fun _ => false), (bitCut 0).pull (fun _ => true)) ∈ ((bitCut 0).read hb).between := by
    have hin : bitPair ∈ (bitCut 0).identified hb := by
      refine bitPair_mem hb fun m hm p hp => ?_
      obtain rfl := Nested.eq_of_atDepth_zero hm
      obtain ⟨_, rfl⟩ := hp
      exact mem_constitution_blank _
    exact ((Cut.mem_identified_iff_between _ hb _ _).mp hin).resolve_left hne
  refine ⟨n, a, bitCut 0, ha, hb, ⟨le_rfl, fun z _ => mem_kernel_const () z⟩, ?_⟩
  change (a.read ha).between.ncard < ((bitCut 0).read hb).between.ncard
  rw [hempty, Set.ncard_empty]
  exact Set.ncard_pos (Set.toFinite _) |>.mpr ⟨_, hmem⟩

/-- **Claim 17 (Every level, every join), a cut with every part at work.** Reading is not vacuous: over two histories, at depth one of a nested arrangement, a scale that identifies a pair of distinct states reads exactly a process whose response varies, and the process read responds differently at two joint states. -/
theorem cut_reads_with_every_part :
    ∃ (S : Type) (_ : Fintype S) (n : Nested S) (cut : Cut S Bool) (h : cut.ReadsExactly n),
      cut.level = 1 ∧ (∃ s t, s ≠ t ∧ cut.scale s = cut.scale t) ∧
        ∃ (x : n.LevelPositions cut.level) (f g : Bool → S), ((cut.readExactly h).process x).response (cut.pull f) ≠ ((cut.readExactly h).process x).response (cut.pull g) := by
  let p : Process (Bool × Bool) := Process.reading Prod.fst
  let n : Nested (Bool × Bool) := tower p p Prod.fst
  let cut : Cut (Bool × Bool) Bool := ⟨1, Bool, Prod.fst⟩
  have hat : n.AtDepth 1 (towerInner p p Prod.fst) := tower_atDepth _ _ _
  have hreads : cut.ReadsExactly n := by
    refine ⟨⟨_, hat⟩, fun m hm z hz => (Nested.mem_kernel_response_asProcess m z).mpr fun q hq => ?_⟩
    obtain ⟨i, hi⟩ := Nested.atDepth_one_iff.mp hm
    obtain rfl : towerInner p p Prod.fst = m := Option.some.inj hi
    obtain ⟨b, rfl⟩ := hq
    cases b <;> exact hz
  obtain ⟨x, hx⟩ := n.exists_atLevel hat
  refine ⟨Bool × Bool, inferInstance, n, cut, hreads, rfl, ⟨(false, false), (false, true), by decide, rfl⟩, x, fun _ => (false, false), fun _ => (true, false), fun heq => ?_⟩
  have hsilent := congrFun (congrFun heq true)
  have hmembers : ∀ i, ((n.atLevel cut.level x).level.process i).response (false, false) = ((n.atLevel cut.level x).level.process i).response (true, false) := by
    intro i
    exact (cut.response_readExactly hreads x (fun _ => (false, false)) true i).symm.trans ((hsilent i).trans (cut.response_readExactly hreads x (fun _ => (true, false)) true i))
  have htower : n.atLevel cut.level x = towerInner p p Prod.fst := hx
  revert hmembers
  rw [htower]
  intro hmembers
  exact Bool.false_ne_true (hmembers true)

/-- **Claim 17 (Every level, every join), a join at a cut.** Where, at a cut's scale, what the first arrangement at its level makes is the finer of two, so that what the second tells apart lies within what the first does, the second's reading at a history is a map of the first's: a join between the processes the cut reads, the first the giver and the second the taker. -/
noncomputable def Cut.joinOfLE (cut : Cut S τ) {n : Nested S} (h : cut.Stands n) {x y : n.LevelPositions cut.level} (hne : x ≠ y) (t : τ)
    (hle : (n.atLevel cut.level x).asProcess.makesAtScale cut.scale ≤ (n.atLevel cut.level y).asProcess.makesAtScale cut.scale) : Join (cut.read h).process where
  taker := y
  giver := x
  another := hne
  source := (t, ())
  made := (t, ())
  further := Quotient.map' id fun _ _ hst => hle hst
  made_eq := fun f => by
    change (n.atLevel cut.level y).asProcess.furtherAtScale cut.scale ((n.atLevel cut.level y).asProcess.constitutiveAtScale cut.scale (f t)) =
      Quotient.map' id (fun _ _ hst => hle hst) ((n.atLevel cut.level x).asProcess.furtherAtScale cut.scale ((n.atLevel cut.level x).asProcess.constitutiveAtScale cut.scale (f t)))
    induction f t using Quotient.inductionOn with
    | _ s => rfl

/-- **Claim 17 (Every level, every join), a join occurs at a cut.** So Claim 17 (Every level, every join) at a cut is not empty: at depth one of a nested arrangement, over one history, one arrangement reads two bits and another reads the first of them, and the second's reading is a map of the first's that is not constant. -/
theorem cut_reads_a_join :
    ∃ (S : Type) (_ : Fintype S) (n : Nested S) (cut : Cut S Unit) (h : cut.Stands n) (j : Join (cut.read h).process), j ∈ (cut.read h).joins ∧ ∃ u v, j.further u ≠ j.further v := by
  let pg : Process (Bool × Bool) := Process.reading id
  let pt : Process (Bool × Bool) := Process.reading Prod.fst
  let mg : Nested (Bool × Bool) := Nested.flat pg
  let mt : Nested (Bool × Bool) := Nested.flat pt
  let n : Nested (Bool × Bool) := .mk Process.blank ⟨inferInstance, fun b : Bool => cond b pg pt, ∅⟩ fun b => cond b (some mg) (some mt)
  let cut : Cut (Bool × Bool) Unit := ⟨1, Bool × Bool, id⟩
  have hg : n.AtDepth 1 mg := .inside (i := true) rfl (.here mg)
  have ht : n.AtDepth 1 mt := .inside (i := false) rfl (.here mt)
  have hreads : cut.Stands n := ⟨mg, hg⟩
  obtain ⟨x, hx⟩ := n.exists_atLevel hg
  obtain ⟨y, hy⟩ := n.exists_atLevel ht
  have hdiff : s(((false, false) : Bool × Bool), ((false, true) : Bool × Bool)) ∈ pt.constitution := (mem_kernel Prod.fst _ _).mpr rfl
  have hne : x ≠ y := by
    rintro rfl
    have hsame : mg = mt := hx.symm.trans hy
    have hself : pg = pt := congrArg Nested.self hsame
    have hk : s(((false, false) : Bool × Bool), ((false, true) : Bool × Bool)) ∈ pg.constitution := hself ▸ hdiff
    exact absurd ((mem_kernel id _ _).mp hk) (by decide)
  have hscale : ∀ s t : Bool × Bool, (Setoid.ker cut.scale) s t → s = t := fun _ _ hst => hst
  have hJt : (n.atLevel cut.level y).asProcess.makesAtScale cut.scale ≤ Setoid.ker Prod.fst := by
    change (n.atLevel 1 y).asProcess.makesAtScale cut.scale ≤ _
    rw [hy]
    refine mt.asProcess.makesAtScale_le cut.scale Prod.fst (fun z hz => ?_) (kernel_id_subset _)
    induction z with
    | _ a b => exact (mem_kernel Prod.fst a b).mpr (congrFun ((mem_kernel _ a b).mp hz) ⟨(), ()⟩)
  have hle : (n.atLevel cut.level x).asProcess.makesAtScale cut.scale ≤ (n.atLevel cut.level y).asProcess.makesAtScale cut.scale := by
    change (n.atLevel 1 x).asProcess.makesAtScale cut.scale ≤ (n.atLevel 1 y).asProcess.makesAtScale cut.scale
    rw [hx, hy]
    refine sup_le ?_ le_sup_right
    intro a b hab
    have heq : a = b := congrFun hab ⟨(), ()⟩
    rw [heq]
  refine ⟨Bool × Bool, inferInstance, n, cut, hreads, cut.joinOfLE hreads hne () hle, Set.mem_univ _, Quotient.mk _ (false, false), Quotient.mk _ (true, false), fun heq => ?_⟩
  have hclass : (n.atLevel cut.level y).asProcess.makesAtScale cut.scale (false, false) (true, false) := Quotient.exact heq
  exact Bool.false_ne_true (hJt hclass)

/-- **Claim 17 (Every level, every join), the span.** Reading one history out of a span is a coarsening of the process over the span: that process carries each history, so what it identifies at the joint states, reading one history identifies too. So the process over a span drops no case, and going from a span to one of its histories coarsens it. -/
theorem history_of_span_coarsens (p : Process S) (τ : Type) (t : τ) :
    (p.overSpan τ).Carries (fun f k => p.grainings k (f t)) ∧
      kernel (p.overSpan τ).constitutive ⊆ kernel fun f : τ → S => p.constitutive (f t) := by
  refine ⟨⟨fun v k => v (t, k), rfl⟩, ?_⟩
  exact kernel_subset_of_carries ⟨fun v => v t, rfl⟩

/-- **Claim 17 (Every level, every join), how far the exact reading reaches.** With one response at a cut's level that tells every two states apart, only a scale that identifies nothing reads exactly. Every other scale has the total reading. -/
theorem readsExactly_forces_injective (cut : Cut S τ) {n m : Nested S} {p : Process S} (h : cut.ReadsExactly n) (hm : n.AtDepth cut.level m) (hp : m.HoldsProcess p)
    (hinj : Function.Injective p.response) : Function.Injective cut.scale := by
  intro s t hst
  have hk : s(s, t) ∈ kernel cut.scale := (mem_kernel _ s t).mpr hst
  exact hinj ((mem_kernel _ s t).mp (((cut.readsExactly_iff n).mp h).2 m hm p hp hk))

end Companion
